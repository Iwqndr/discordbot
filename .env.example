# Copy to .env and fill in. Every key below is optional except DISCORD_TOKEN:
# config.py falls back to the values this deployment already used.

DISCORD_TOKEN=your-bot-token

# Guild the bot syncs slash commands against.
GUILD_ID=0

# Command prefix, default ">".
COMMAND_PREFIX=>

# Role allowed to run "posthelp", and the role verification grants.
POSTHELP_ROLE_ID=1548496816989798400
VERIFIED_ROLE_ID=1548559332063313921

# Categories in the archive guild that hold the log channels.
MESSAGE_CATEGORY_ID=1548581331175350363
SYSTEM_CATEGORY_ID=1548582743368147015

# Console output. LOG_DEBUG=1 shows the per-message logging detail
# (thread/buffer/flush lines) that is hidden by default.
LOG_DEBUG=0

# FORCE_COLOR=1 keeps ANSI colors even when output is redirected; NO_COLOR=1
# disables them.

# Names of the log channels created under those categories.
MESSAGE_LOG_PARENT_NAME=user-message-logs
SYSTEM_LOG_PARENT_NAME=system-logs

# Support tickets from the member page (http://localhost:5000/member).
# Channel that new tickets are posted in, and an optional role to ping.
TICKET_CHANNEL_ID=0
TICKET_PING_ROLE_ID=0

# Discord login on the member page. Make an app at
# https://discord.com/developers/applications, add
# http://localhost:5000/auth/discord/callback as a redirect URL, then copy
# the client id and secret here. Only the "identify" scope is used.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback
# Signs the login cookie. Use any long random text of your own.
FLASK_SECRET_KEY=change-this-to-something-random

# Catbox.moe uploads for ticket attachments. Server-side only: the value
# never reaches the browser. Get it from your Catbox account page.
CATBOX_USERHASH=
# Optional overrides for the attachment limits.
TICKET_ATTACH_MAX_FILES=3
TICKET_ATTACH_MAX_MB=5

# Where the "contact support" link in a ban/kick DM points. Optional: when it
# is left out the DM still says how to appeal, just without a link.
# SUPPORT_LINK=https://discord.gg/yourserver

# Supabase (member sync, command usage counters).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
