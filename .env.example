DISCORD_TOKEN=your-bot-token

GUILD_ID=0

COMMAND_PREFIX=>

POSTHELP_ROLE_ID=1548496816989798400
VERIFIED_ROLE_ID=1548559332063313921

MESSAGE_CATEGORY_ID=1548581331175350363
SYSTEM_CATEGORY_ID=1548582743368147015

LOG_DEBUG=0

MESSAGE_LOG_PARENT_NAME=user-message-logs
SYSTEM_LOG_PARENT_NAME=system-logs

# The channel the bot posts new member-page tickets in, and an optional role to
# ping for each one. Tickets are filed in Supabase (the site cannot reach
# Discord), and this process drains them: it creates the panel ticket, posts the
# embed, and updates the member's own copy. Its heartbeat in `bot_status` is what
# tells the site to file a new ticket as open, or as "Processing" while the bot
# is down — the ticket waits in the queue and appears the moment it starts.
TICKET_CHANNEL_ID=0
TICKET_PING_ROLE_ID=0

# --- Discord login ---------------------------------------------------------
# Two redirects go in the Discord app (OAuth2 -> Redirects), and both are on the
# member site, which never changes address:
#
#   https://jamesheston.pages.dev/auth/discord/callback   the member page's login
#   https://jamesheston.pages.dev/authorize               the admin panel's login
#
# The panel needs one of its own because its public address is a quick tunnel that
# is new on every restart: registering that would mean editing the Discord app
# every time. Asking for the fixed `/authorize` instead means the member site
# answers, then forwards the login on to whichever tunnel is live.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The member page's own login. Only used by the Cloudflare Worker.
DISCORD_REDIRECT_URI=https://jamesheston.pages.dev/auth/discord/callback

# Where Discord sends a panel login. Defaults to `<MEMBER_SITE_URL>/authorize`
# when MEMBER_SITE_URL is set, so this line is usually not needed.
PANEL_AUTHORIZE_URI=https://jamesheston.pages.dev/authorize

FLASK_SECRET_KEY=change-this-to-something-random

CATBOX_USERHASH=

# Public address of the member page (the Cloudflare deployment).
MEMBER_SITE_URL=https://jamesheston.pages.dev

# Optional, and only worth setting in BOTH places at once: here and in the Pages
# environment variables. With it, the member site can hand a signed-in member
# straight into the panel (`/auth/handoff`) without a second Discord round trip,
# and the panel's login state gets a signature the member site verifies. With it
# set on only one side, the panel's login simply uses the fixed `/authorize` flow
# above — nothing breaks, the silent handoff just never happens.
# PANEL_HANDOFF_SECRET=

TICKET_ATTACH_MAX_FILES=3
TICKET_ATTACH_MAX_MB=5

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Public panel tunnel (referenced/tunnel.py) -----------------------------
# The public link is a cloudflared QUICK tunnel: free, no Cloudflare account, no
# domain, and nothing between the browser and the panel. Its address is random
# and changes on restart, but jamesheston.pages.dev/dashboard always redirects to
# the current one, so that is the link to share.
#
# Better still, put that link behind a permanent address (see the settings at the
# bottom of this section). A quick tunnel's name is new on every restart, and a
# name that is seconds old is answered "does not exist" by a lot of resolvers —
# mobile carriers and home routers especially — so a visitor on that network gets
# a blank page for a minute or two while the panel itself is perfectly fine. That
# is not something a visitor can fix on their end, which is exactly why nobody
# should be handed the disposable address.
#
# localtunnel is the fallback. Its address is stable (<name>.loca.lt), but the
# loca.lt service shows browsers an HTTP 511 "Tunnel website ahead" page before
# forwarding them, so it is a worse link to hand to anybody.
#
# Note: an already-set environment variable beats .env (python-dotenv never
# overwrites one), so if TUNNEL_PROVIDER is exported in the shell, a systemd
# unit or a start script, this file's value is ignored and the startup log says
# so. Clear it there to let .env decide.
#
# DASHBOARD_TUNNEL=0                             turn the tunnel off entirely
# TUNNEL_PROVIDER=cloudflared                    the default, or 'localtunnel' first
# CLOUDFLARED_PATH=                              exact path to the cloudflared
#                                                binary, when it is installed
#                                                somewhere the search misses
# LOCALTUNNEL_SUBDOMAIN=jamesheston              the name in <name>.loca.lt
# LOCALTUNNEL_ATTEMPTS=3                         tries before giving up on localtunnel
# LOCALTUNNEL_PORT=                              tunnel a port other than 5000
# CLOUDFLARE_TUNNEL_PROTOCOL=http2               only if a quick tunnel connects
#                                                but never answers (blocks UDP 7844)
#
# Named cloudflared tunnel. Needs a domain on Cloudflare whose hostname routes to
# the tunnel; without one it answers nothing. Leave CLOUDFLARE_TUNNEL_MODE unset
# to stay on quick tunnels.
# CLOUDFLARE_TUNNEL_MODE=named
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_URL=https://panel.example.com
#
# A permanent address for the panel, so nobody ever sees the tunnel directly:
# deploy workers/panel-proxy.js to a Cloudflare Worker (free) and put its address
# here. The Worker reads the current tunnel address from Supabase and forwards
# every request to it, so one bookmark keeps working across restarts and across
# whichever tunnel provider is in use — and on a loca.lt fallback it also skips
# the click-through page, because that hop is server to server. Set it here and
# in the Pages project (see pages/README.md); the startup log then prints the
# permanent address as the one to share, next to the address it forwards to.
# PANEL_PUBLIC_URL=https://panel.example.workers.dev

# --- Discord connection -----------------------------------------------------
# The bot reaches Discord over IPv4 only. aiohttp otherwise dials every address a
# name resolves to, in parallel, and on some networks that fails the TLS
# handshake to discord.com intermittently (measured here: 4 of 6 attempts, against
# 6 of 6 with IPv4 alone) — every failure costs a retry, so startup stalls and the
# gateway reconnects in a loop. Set this to 0 to dial both families again.
# DISCORD_IPV4_ONLY=0
