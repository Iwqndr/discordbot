<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Command List</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Fredoka:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f4efe6; --bg-dot: #d9d2c4; --card: #fdfbf6; --border: #c9c0ad;
    --border-soft: #e5ddcc; --text: #3a342a; --muted: #7a7161;
    --accent: #6ea8c9; --accent-dark: #4a7f9e; --accent-soft: #cde4f0;
    --code-bg: #2b2620; --code-text: #f4efe6; --kbd-bg: #efe8da; --kbd-border: #c9c0ad;
  }
  [data-theme="dark"] {
    --bg: #1a1815; --bg-dot: #2a2622; --card: #232019; --border: #3d3830;
    --border-soft: #302b25; --text: #f0ebe0; --muted: #9a9284;
    --accent: #7bb8d9; --accent-dark: #a8d4ec; --accent-soft: #2c4354;
    --code-bg: #14120f; --code-text: #f0ebe0; --kbd-bg: #2a2620; --kbd-border: #4a443a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  html, body {
    background-color: var(--bg);
    background-image: radial-gradient(var(--bg-dot) 1px, transparent 1px);
    background-size: 14px 14px;
    color: var(--text);
    font-family: "Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    min-height: 100vh; line-height: 1.55; -webkit-font-smoothing: antialiased;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 22px 100px; }
  .topbar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin-bottom: 32px; animation: fadeUp 0.5s ease both;
  }
  .brand {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 15px;
    color: var(--muted); letter-spacing: 0.02em;
  }
  .brand .dot-brand {
    display: inline-block; width: 8px; height: 8px; background: var(--accent-dark);
    border-radius: 50%; margin-right: 8px; vertical-align: middle;
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }
  .topbar-actions { display: flex; gap: 8px; }
  .icon-btn {
    width: 38px; height: 38px; border-radius: 12px;
    background: var(--card); border: 2px solid var(--border); color: var(--text);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: transform 0.2s ease, border-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .icon-btn:hover { transform: translateY(-2px); border-color: var(--accent-dark); }
  .icon-btn.active { border-color: var(--accent-dark); background: var(--accent-soft); }
  .icon-btn svg { width: 18px; height: 18px; }
  header { text-align: center; margin-bottom: 32px; animation: fadeUp 0.6s ease both; }
  h1 {
    font-family: "Fredoka", sans-serif; font-weight: 600;
    font-size: clamp(38px, 7vw, 62px); color: var(--text);
    letter-spacing: -0.01em; margin-bottom: 10px; line-height: 1;
  }
  h1 .accent { color: var(--accent-dark); }
  .subtitle { color: var(--muted); font-size: 16px; font-weight: 600; }
  .stats {
    display: flex; justify-content: center; gap: 24px; margin: 22px 0 30px;
    flex-wrap: wrap; animation: fadeUp 0.6s ease 0.1s both;
  }
  .stat { text-align: center; min-width: 80px; }
  .stat-num {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 24px;
    color: var(--accent-dark); line-height: 1; font-variant-numeric: tabular-nums;
  }
  .stat-num small { font-size: 13px; font-weight: 600; color: var(--muted); }
  .stat-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--muted); margin-top: 4px;
  }
  .controls { position: sticky; top: 12px; z-index: 20; margin-bottom: 18px; animation: fadeUp 0.6s ease 0.15s both; }
  .search-wrap {
    position: relative; background: var(--card); border: 2px solid var(--border);
    border-radius: 16px; padding: 0 14px 0 44px;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .search-wrap.focused { border-color: var(--accent-dark); box-shadow: 0 0 0 4px var(--accent-soft); }
  .search-icon {
    position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
    width: 18px; height: 18px; color: var(--muted); pointer-events: none;
    transition: color 0.2s ease;
  }
  .search-wrap.focused .search-icon { color: var(--accent-dark); }
  #searchInput {
    width: 100%; padding: 14px 0; font-family: inherit; font-size: 15px;
    font-weight: 600; color: var(--text); background: transparent;
    border: none; outline: none;
  }
  #searchInput::placeholder { color: var(--muted); font-weight: 500; opacity: 0.7; }
  .search-clear {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    width: 26px; height: 26px; border-radius: 50%; background: var(--bg);
    border: 1.5px solid var(--border-soft); color: var(--muted);
    display: none; align-items: center; justify-content: center;
    cursor: pointer; transition: transform 0.15s ease, color 0.15s ease;
  }
  .search-clear.visible { display: flex; }
  .search-clear:hover { transform: translateY(-50%) scale(1.1); color: var(--accent-dark); }
  .search-clear svg { width: 12px; height: 12px; }
  .kbd-hint {
    position: absolute; right: 46px; top: 50%; transform: translateY(-50%);
    font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 600;
    color: var(--muted); background: var(--kbd-bg); border: 1.5px solid var(--kbd-border);
    border-radius: 6px; padding: 2px 7px; pointer-events: none; opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .search-wrap.focused .kbd-hint,
  #searchInput:not(:placeholder-shown) ~ .kbd-hint { opacity: 0; }
  .filters { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; align-items: center; }
  .filter-chip {
    font-family: inherit; font-size: 12.5px; font-weight: 700;
    padding: 6px 12px; border-radius: 999px; background: var(--card);
    border: 1.5px solid var(--border); color: var(--muted); cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    transition: all 0.2s ease; -webkit-tap-highlight-color: transparent; user-select: none;
  }
  .filter-chip:hover { transform: translateY(-1px); color: var(--text); }
  .filter-chip.active {
    background: var(--chip-color-soft, var(--accent-soft));
    border-color: var(--chip-color, var(--accent-dark));
    color: color-mix(in srgb, var(--chip-color, var(--accent-dark)) 80%, #000 20%);
  }
  [data-theme="dark"] .filter-chip.active {
    color: color-mix(in srgb, var(--chip-color, var(--accent)) 60%, #fff 40%);
  }
  .filter-chip .chip-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--chip-color, var(--muted)); }
  .filter-chip .chip-count { font-size: 10.5px; opacity: 0.7; font-variant-numeric: tabular-nums; }
  .sort-toggle {
    margin-left: auto; font-family: inherit; font-size: 12px; font-weight: 700;
    padding: 6px 12px; border-radius: 999px; background: var(--card);
    border: 1.5px solid var(--border); color: var(--muted); cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;
  }
  .sort-toggle:hover { color: var(--text); transform: translateY(-1px); }
  .results-meta {
    font-size: 13px; color: var(--muted); font-weight: 600;
    margin-bottom: 14px; min-height: 20px; padding: 0 4px;
    transition: opacity 0.2s ease;
  }
  .results-meta.hidden { opacity: 0; }
  .results-meta strong { color: var(--accent-dark); }
  .results-meta .clear-search { color: var(--accent-dark); text-decoration: underline; cursor: pointer; margin-left: 6px; }
  .roles { display: flex; flex-direction: column; gap: 16px; }
  .role {
    background: var(--card); border: 2px solid var(--border); border-radius: 20px;
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    animation: fadeUp 0.55s ease both; animation-delay: calc(var(--i) * 40ms);
  }
  .role:hover { transform: translateY(-2px); box-shadow: 0 6px 0 rgba(0,0,0,0.06); }
  .role.open {
    border-color: color-mix(in srgb, var(--role-color) 55%, var(--border));
    box-shadow: 0 6px 0 rgba(0,0,0,0.06);
  }
  .role.hidden { display: none; }
  .role-header {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 18px 22px; cursor: pointer; user-select: none;
    -webkit-tap-highlight-color: transparent; transition: background 0.22s ease;
  }
  .role.open .role-header { background: color-mix(in srgb, var(--role-color-soft) 45%, transparent); }
  .role-left { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .badge {
    width: 38px; height: 38px; border-radius: 12px;
    background: var(--role-color-soft);
    border: 2px solid color-mix(in srgb, var(--role-color) 55%, var(--border));
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    font-family: "Fredoka", sans-serif; font-weight: 600;
    color: color-mix(in srgb, var(--role-color) 80%, #000 20%); font-size: 16px;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .role.open .badge { transform: rotate(-6deg) scale(1.05); }
  .role-name {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 21px;
    color: var(--text); letter-spacing: -0.005em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .count {
    color: var(--muted); font-size: 13px; font-weight: 700; background: var(--bg);
    padding: 3px 10px; border-radius: 999px; border: 1.5px solid var(--border-soft);
    white-space: nowrap;
  }
  .role-actions { display: flex; align-items: center; gap: 8px; }
  .mini-btn {
    width: 30px; height: 30px; border-radius: 10px; background: transparent;
    border: 1.5px solid var(--border-soft); color: var(--muted);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .mini-btn:hover { color: var(--accent-dark); border-color: var(--accent-dark); transform: translateY(-1px); }
  .mini-btn svg { width: 14px; height: 14px; }
  .chevron {
    width: 22px; height: 22px; color: var(--muted);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.22s ease;
    flex-shrink: 0;
  }
  .role.open .chevron { transform: rotate(180deg); color: var(--role-color); }
  .role-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
  .role.open .role-body { grid-template-rows: 1fr; }
  .role-body-inner { overflow: hidden; }
  .cmd-list { padding: 4px 16px 22px; display: flex; flex-direction: column; gap: 4px; }
  .cmd-wrap {
    border-radius: 12px; transition: background 0.18s ease;
    opacity: 0; transform: translateY(-4px);
  }
  .role.open .cmd-wrap {
    animation: cmdIn 0.32s ease forwards;
    animation-delay: calc(var(--j) * 12ms);
  }
  .cmd-wrap.open { background: var(--bg); }
  .cmd-wrap.hidden { display: none; }
  .cmd-wrap.favorite .cmd::after {
    content: ""; position: absolute; left: 0; top: 14%; bottom: 14%;
    width: 3px; border-radius: 999px; background: #e5b23c;
  }
  .cmd {
    position: relative; display: flex; align-items: baseline; gap: 12px;
    padding: 9px 14px; border-radius: 12px; cursor: pointer; user-select: none;
    -webkit-tap-highlight-color: transparent; transition: background 0.18s ease;
  }
  .cmd:hover { background: rgba(0,0,0,0.025); }
  [data-theme="dark"] .cmd:hover { background: rgba(255,255,255,0.03); }
  .cmd-wrap.open .cmd { background: transparent; padding-bottom: 6px; }
  .cmd code {
    font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
    font-size: 12.5px; font-weight: 600;
    color: color-mix(in srgb, var(--role-color) 85%, #000 15%);
    background: var(--role-color-soft);
    border: 1.5px solid color-mix(in srgb, var(--role-color) 40%, transparent);
    padding: 3px 10px; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
  }
  .cmd-desc { color: var(--muted); font-size: 14px; font-weight: 500; flex: 1; }
  .cmd-desc mark { background: #ffe07a; color: #5a4000; border-radius: 3px; padding: 0 2px; font-weight: 700; }
  [data-theme="dark"] .cmd-desc mark { background: #6b5a1e; color: #ffe9a8; }
  .cmd-arrow {
    width: 16px; height: 16px; color: var(--muted); flex-shrink: 0; align-self: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease;
  }
  .cmd-wrap.open .cmd-arrow { transform: rotate(90deg); color: var(--role-color); }
  .fav-btn {
    width: 22px; height: 22px; border-radius: 50%; background: transparent;
    border: none; color: var(--muted); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; align-self: center; opacity: 0;
    transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .cmd:hover .fav-btn,
  .cmd-wrap.favorite .fav-btn { opacity: 1; }
  .fav-btn:hover { transform: scale(1.2); }
  .cmd-wrap.favorite .fav-btn svg { fill: #e5b23c; }
  .fav-btn svg { width: 14px; height: 14px; fill: currentColor; }
  .docs { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.38s cubic-bezier(0.4, 0, 0.2, 1); }
  .cmd-wrap.open .docs { grid-template-rows: 1fr; }
  .docs-inner { overflow: hidden; }
  .docs-content { padding: 8px 16px 16px 16px; font-size: 13.5px; color: var(--text); }
  .docs-content h4 {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 12.5px;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: color-mix(in srgb, var(--role-color) 75%, #000 25%);
    margin-top: 14px; margin-bottom: 6px;
    display: flex; align-items: center; gap: 8px;
  }
  [data-theme="dark"] .docs-content h4 { color: color-mix(in srgb, var(--role-color) 60%, #fff 40%); }
  .docs-content h4:first-child { margin-top: 0; }
  .docs-content h4::after { content: ""; flex: 1; height: 1.5px; background: var(--border-soft); border-radius: 1px; }
  .docs-content p { color: var(--text); font-weight: 500; line-height: 1.6; margin-bottom: 6px; }
  .docs-content ul { list-style: none; padding: 0; margin: 0 0 6px 0; }
  .docs-content li {
    position: relative; padding-left: 18px; margin-bottom: 4px;
    color: var(--text); font-weight: 500; line-height: 1.55;
  }
  .docs-content li::before {
    content: ""; position: absolute; left: 4px; top: 9px;
    width: 5px; height: 5px; border-radius: 50%;
    background: color-mix(in srgb, var(--role-color) 70%, transparent);
  }
  .docs-content code {
    font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
    font-size: 12px; font-weight: 500;
    color: color-mix(in srgb, var(--role-color) 80%, #000 20%);
    background: color-mix(in srgb, var(--role-color-soft) 80%, #fff 20%);
    padding: 1px 6px; border-radius: 5px;
    border: 1px solid color-mix(in srgb, var(--role-color) 25%, transparent);
  }
  [data-theme="dark"] .docs-content code {
    background: color-mix(in srgb, var(--role-color-soft) 50%, transparent);
    color: color-mix(in srgb, var(--role-color) 65%, #fff 35%);
  }
  .docs-content pre {
    font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
    font-size: 12.5px; line-height: 1.6; background: var(--code-bg);
    color: var(--code-text); padding: 12px 14px; border-radius: 10px;
    overflow-x: auto; margin: 6px 0 10px 0; border: 1.5px solid #1a1713;
    box-shadow: inset 0 2px 0 rgba(255,255,255,0.05); position: relative;
  }
  .docs-content pre .tok-cmd { color: #ffd580; font-weight: 600; }
  .docs-content pre .tok-arg { color: #a0d8ff; }
  .docs-content pre .tok-opt { color: #c8b6ff; }
  .docs-content pre .tok-bot { color: #7bd88f; }
  .docs-content .label {
    display: inline-block; font-size: 11px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    padding: 2px 8px; border-radius: 999px;
    background: var(--role-color-soft);
    color: color-mix(in srgb, var(--role-color) 80%, #000 20%);
    margin-right: 6px;
  }
  .docs-content .req { background: #f6d5d5; color: #8a2a2a; }
  [data-theme="dark"] .docs-content .req { background: #4a2020; color: #f0b8b8; }
  .docs-content .opt { background: #d6e4f4; color: #2a4a6b; }
  [data-theme="dark"] .docs-content .opt { background: #1e3040; color: #b8d4ec; }
  .copy-btn {
    position: absolute; top: 8px; right: 8px;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
    color: #f4efe6; border-radius: 6px; padding: 4px 8px;
    font-family: inherit; font-size: 11px; font-weight: 700;
    cursor: pointer; opacity: 0;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .docs-content pre:hover .copy-btn { opacity: 1; }
  .copy-btn:hover { background: rgba(255,255,255,0.15); }
  .copy-btn.copied { background: #4a7f4a; border-color: #7bd88f; }
  .run-count {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 14px; padding: 6px 12px;
    background: color-mix(in srgb, var(--role-color-soft) 60%, transparent);
    border: 1.5px dashed color-mix(in srgb, var(--role-color) 45%, transparent);
    border-radius: 10px; font-size: 12px; font-weight: 700;
    color: color-mix(in srgb, var(--role-color) 75%, #000 25%);
  }
  [data-theme="dark"] .run-count { color: color-mix(in srgb, var(--role-color) 60%, #fff 40%); }
  .run-count .pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: color-mix(in srgb, var(--role-color) 80%, #000 20%);
    animation: pulse 2s ease-in-out infinite;
  }
  .no-results { text-align: center; padding: 60px 20px; color: var(--muted); display: none; }
  .no-results.visible { display: block; animation: fadeUp 0.4s ease both; }
  .no-results-icon { width: 60px; height: 60px; margin: 0 auto 16px; color: var(--border); }
  .no-results-title { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 20px; color: var(--text); margin-bottom: 6px; }
  .no-results-desc { font-size: 14px; font-weight: 500; }
  footer {
    text-align: center; color: var(--muted); font-size: 14px; font-weight: 600;
    margin-top: 52px; animation: fadeUp 0.6s ease 0.4s both;
  }
  footer .box {
    display: inline-block; background: var(--card); border: 2px solid var(--border);
    border-radius: 999px; padding: 8px 20px; transition: transform 0.2s ease;
  }
  footer .box:hover { transform: translateY(-2px); }
  .scroll-top {
    position: fixed; bottom: 24px; right: 24px;
    width: 46px; height: 46px; border-radius: 14px;
    background: var(--card); border: 2px solid var(--border); color: var(--text);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; opacity: 0; pointer-events: none; transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease, border-color 0.2s ease;
    z-index: 30; box-shadow: 0 4px 0 rgba(0,0,0,0.08);
  }
  .scroll-top.visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .scroll-top:hover { border-color: var(--accent-dark); transform: translateY(-2px); }
  .scroll-top svg { width: 20px; height: 20px; }
  .profile-backdrop {
    position: fixed; inset: 0; background: rgba(0,0,0,0.35);
    backdrop-filter: blur(2px); opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease; z-index: 40;
  }
  .profile-backdrop.visible { opacity: 1; pointer-events: auto; }
  .profile-panel {
    position: fixed; top: 0; left: 0;
    width: 360px; max-width: 90vw; height: 100vh;
    background: var(--card); border-right: 2px solid var(--border);
    transform: translateX(-100%);
    transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 50; overflow-y: auto; display: flex; flex-direction: column;
  }
  .profile-panel.visible { transform: translateX(0); }
  .profile-close {
    position: absolute; top: 12px; right: 12px;
    width: 32px; height: 32px; border-radius: 10px;
    background: rgba(0,0,0,0.35); border: 1.5px solid rgba(255,255,255,0.2);
    color: #fff; display: flex; align-items: center; justify-content: center;
    cursor: pointer; z-index: 2;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .profile-close:hover { background: rgba(0,0,0,0.55); transform: scale(1.05); }
  .profile-close svg { width: 14px; height: 14px; }
  .profile-banner {
    height: 120px; background-size: cover; background-position: center;
    background-color: var(--accent-soft); position: relative;
  }
  .profile-banner::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.4));
  }
  .profile-avatar-wrap { position: relative; margin-top: -46px; margin-left: 22px; z-index: 2; }
  .profile-avatar {
    width: 92px; height: 92px; border-radius: 24px;
    border: 4px solid var(--card); background: var(--card); object-fit: cover;
    box-shadow: 0 6px 16px rgba(0,0,0,0.15);
  }
  .profile-status-dot {
    position: absolute; bottom: 4px; right: 4px;
    width: 18px; height: 18px; border-radius: 50%;
    background: #7bd88f; border: 4px solid var(--card);
  }
  .profile-body { padding: 14px 22px 30px; flex: 1; display: flex; flex-direction: column; }
  .profile-name {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 22px;
    color: var(--text); line-height: 1.2; word-break: break-word;
  }
  .profile-handle {
    font-family: "JetBrains Mono", monospace; font-size: 13px;
    color: var(--muted); margin-top: 2px; word-break: break-all;
  }
  .profile-bio {
    color: var(--text); font-size: 14px; font-weight: 500;
    margin-top: 12px; padding: 12px 14px; background: var(--bg);
    border-radius: 12px; border: 1.5px solid var(--border-soft);
    min-height: 44px; line-height: 1.5;
  }
  .profile-bio.empty { color: var(--muted); font-style: italic; }
  .profile-section-title {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 11px;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted); margin-top: 20px; margin-bottom: 8px;
  }
  .profile-roles { display: flex; flex-wrap: wrap; gap: 6px; }
  .profile-role-chip {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px;
    background: var(--bg);
    border: 1.5px solid var(--chip-color, var(--border-soft));
    color: color-mix(in srgb, var(--chip-color, var(--muted)) 80%, #000 20%);
  }
  [data-theme="dark"] .profile-role-chip {
    color: color-mix(in srgb, var(--chip-color, var(--muted)) 65%, #fff 35%);
  }
  .profile-role-chip .chip-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--chip-color, var(--muted)); }
  .profile-meta { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .profile-meta-row {
    display: flex; justify-content: space-between; gap: 12px;
    font-size: 13px; padding: 8px 12px; background: var(--bg);
    border-radius: 10px; border: 1.5px solid var(--border-soft);
  }
  .profile-meta-label { color: var(--muted); font-weight: 700; }
  .profile-meta-value {
    color: var(--text); font-weight: 600;
    font-family: "JetBrains Mono", monospace; font-size: 12px;
    text-align: right; word-break: break-all;
  }
  .profile-view-cmds {
    margin-top: 20px; width: 100%; padding: 12px 16px; border-radius: 12px;
    background: var(--accent-dark); border: none; color: #fff;
    font-family: inherit; font-size: 14px; font-weight: 800;
    letter-spacing: 0.02em; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: transform 0.2s ease;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--accent-dark) 70%, #000 30%);
  }
  .profile-view-cmds:hover { transform: translateY(-2px); }
  .profile-view-cmds:active { transform: translateY(0); box-shadow: 0 2px 0 color-mix(in srgb, var(--accent-dark) 70%, #000 30%); }
  .profile-view-cmds svg { width: 16px; height: 16px; }
  .profile-empty { padding: 60px 22px; text-align: center; color: var(--muted); }
  .profile-empty-title {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 18px;
    color: var(--text); margin-bottom: 6px;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes cmdIn { to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 600px) {
    .wrap { padding: 24px 14px 80px; }
    .role-header { padding: 16px 18px; }
    .role-name { font-size: 18px; }
    .badge { width: 34px; height: 34px; }
    .cmd-list { padding: 4px 10px 18px; }
    .cmd { flex-wrap: wrap; gap: 8px; }
    .cmd-desc { flex: 1 1 100%; }
    .count { font-size: 12px; padding: 2px 8px; }
    .docs-content { padding: 6px 10px 14px 10px; }
    .stats { gap: 16px; }
    .stat-num { font-size: 20px; }
    .sort-toggle { margin-left: 0; }
    .kbd-hint { display: none; }
    .scroll-top { bottom: 16px; right: 16px; }
    .profile-panel { width: 100vw; }
  }

  /* ============================================================
     MEMBER HUB
     ============================================================ */
  .view[hidden] { display: none !important; }
  .hub-intro { text-align: center; margin-bottom: 24px; animation: fadeUp 0.5s ease both; }
  .hub-title {
    font-family: "Fredoka", sans-serif; font-weight: 600;
    font-size: clamp(30px, 5.5vw, 46px); line-height: 1.05; letter-spacing: -0.01em;
  }
  .hub-title .accent { color: var(--accent-dark); }
  .hub-sub { color: var(--muted); font-weight: 600; font-size: 15px; margin-top: 8px; }
  .hub-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px; margin-bottom: 24px; animation: fadeUp 0.5s ease 0.06s both;
  }
  .hub-card {
    position: relative; text-align: left; background: var(--card);
    border: 2px solid var(--border); border-radius: 18px; padding: 17px;
    font-family: inherit; color: var(--text); cursor: pointer;
    display: flex; flex-direction: column; gap: 9px;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .hub-card:hover { transform: translateY(-3px); border-color: var(--accent-dark); box-shadow: 0 10px 22px rgba(58,52,42,0.08); }
  .hub-card.active { border-color: var(--accent-dark); background: var(--accent-soft); }
  .hub-icon {
    width: 40px; height: 40px; border-radius: 13px; flex: none;
    background: var(--accent-soft); border: 2px solid var(--border);
    color: var(--accent-dark); display: flex; align-items: center; justify-content: center;
  }
  .hub-icon svg { width: 20px; height: 20px; }
  .hub-card-title { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 17px; }
  .hub-card-desc { color: var(--muted); font-size: 13px; font-weight: 600; line-height: 1.45; }
  .hub-badge {
    position: absolute; top: 13px; right: 13px; font-size: 11px; font-weight: 800;
    color: var(--accent-dark); background: var(--accent-soft); border: 1.5px solid var(--accent);
    border-radius: 999px; padding: 2px 9px;
  }
  .tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 22px; animation: fadeUp 0.5s ease 0.1s both; }
  .tab {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--card); border: 2px solid var(--border); color: var(--muted);
    border-radius: 999px; padding: 8px 16px; font-family: inherit;
    font-size: 13px; font-weight: 700; cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }
  .tab svg { width: 15px; height: 15px; }
  .tab:hover { color: var(--text); border-color: var(--accent-dark); transform: translateY(-2px); }
  .tab.active { background: var(--accent); border-color: var(--accent-dark); color: #ffffff; }

  .panel {
    background: var(--card); border: 2px solid var(--border); border-radius: 20px;
    padding: 22px; animation: fadeUp 0.4s ease both;
  }
  .panel + .panel { margin-top: 16px; }
  .panel-title { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 20px; }
  .panel-sub { color: var(--muted); font-size: 14px; font-weight: 600; margin: 5px 0 18px; }

  .topic-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 10px; }
  .topic {
    display: flex; align-items: center; gap: 10px; text-align: left;
    background: var(--bg); border: 2px solid var(--border-soft); border-radius: 14px;
    padding: 13px 14px; font-family: inherit; color: var(--text);
    font-size: 13.5px; font-weight: 700; cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .topic svg { width: 17px; height: 17px; color: var(--accent-dark); flex: none; }
  .topic:hover { transform: translateY(-2px); border-color: var(--accent-dark); }
  .topic.active { border-color: var(--accent-dark); background: var(--accent-soft); }

  .wizard-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .step-label { font-size: 11.5px; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .progress-track { height: 8px; background: var(--bg); border: 1.5px solid var(--border-soft); border-radius: 999px; overflow: hidden; margin-bottom: 20px; }
  .progress-fill { height: 100%; width: 0; background: var(--accent); border-radius: 999px; transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1); }
  .q-label { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 19px; margin-bottom: 6px; }
  .q-hint { color: var(--muted); font-size: 13.5px; font-weight: 600; margin-bottom: 13px; }
  .q-input, .q-textarea, .q-select {
    width: 100%; font-family: inherit; font-size: 15px; font-weight: 600; color: var(--text);
    background: var(--bg); border: 2px solid var(--border); border-radius: 14px;
    padding: 12px 14px; outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .q-select { cursor: pointer; }
  .q-textarea { min-height: 132px; resize: vertical; line-height: 1.55; }
  .q-input:focus, .q-textarea:focus, .q-select:focus { border-color: var(--accent-dark); box-shadow: 0 0 0 4px var(--accent-soft); }
  .q-error { display: none; color: #c2705a; font-size: 13px; font-weight: 700; margin-top: 9px; }
  .q-error.visible { display: block; }
  .counter { text-align: right; font-size: 12px; font-weight: 700; color: var(--muted); margin-top: 6px; }
  .wizard-nav { display: flex; justify-content: space-between; gap: 10px; margin-top: 20px; }

  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: inherit; font-size: 14px; font-weight: 700;
    background: var(--card); color: var(--text); border: 2px solid var(--border);
    border-radius: 14px; padding: 11px 20px; cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, filter 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .btn svg { width: 16px; height: 16px; }
  .btn:hover { transform: translateY(-2px); border-color: var(--accent-dark); }
  .btn.primary { background: var(--accent); border-color: var(--accent-dark); color: #ffffff; }
  .btn.primary:hover { filter: brightness(1.06); }
  .btn.ghost { background: transparent; }
  .btn.danger { color: #c2705a; border-color: #d8a292; }
  .btn.small { padding: 7px 13px; font-size: 12.5px; border-radius: 11px; }
  .btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

  .review-list { display: flex; flex-direction: column; gap: 10px; }
  .review-row { background: var(--bg); border: 2px solid var(--border-soft); border-radius: 14px; padding: 12px 14px; }
  .review-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .review-key { font-size: 11.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  .review-val { font-size: 14.5px; font-weight: 600; white-space: pre-wrap; word-break: break-word; margin-top: 4px; }
  .jump { background: none; border: none; color: var(--accent-dark); font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer; padding: 0; }
  .jump:hover { text-decoration: underline; }

  .identity-box {
    display: flex; align-items: center; gap: 13px; margin-top: 15px;
    border: 2px dashed var(--border); border-radius: 16px; padding: 13px;
  }
  .identity-avatar { width: 46px; height: 46px; border-radius: 50%; border: 2px solid var(--border); object-fit: cover; background: var(--bg); flex: none; }
  .identity-name { font-weight: 800; font-size: 15px; }
  .identity-handle { color: var(--muted); font-size: 13px; font-weight: 700; }

  /* popup */
  .modal-backdrop {
    position: fixed; inset: 0; z-index: 60; background: rgba(38, 33, 26, 0.4);
    -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px);
    opacity: 0; pointer-events: none; transition: opacity 0.28s ease;
  }
  .modal-backdrop.visible { opacity: 1; pointer-events: auto; }
  .modal { position: fixed; inset: 0; z-index: 61; display: flex; align-items: center; justify-content: center; padding: 20px; pointer-events: none; }
  .modal.open { pointer-events: auto; }
  .modal-card {
    width: 100%; max-width: 430px; text-align: center;
    background: var(--card); border: 2px solid var(--border); border-radius: 24px;
    padding: 26px 24px 22px; box-shadow: 0 24px 55px rgba(40, 35, 28, 0.22);
    transform: translateY(20px) scale(0.94); opacity: 0;
    transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.25, 1), opacity 0.3s ease;
  }
  .modal.open .modal-card { transform: translateY(0) scale(1); opacity: 1; }
  .modal-kicker { font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .modal-title { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 22px; margin: 6px 0 16px; }
  .modal-avatar { width: 84px; height: 84px; border-radius: 50%; border: 3px solid var(--accent); object-fit: cover; background: var(--bg); }
  .modal-name { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 19px; margin-top: 12px; }
  .modal-handle { color: var(--muted); font-size: 13.5px; font-weight: 700; }
  .modal-roles { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 13px; }
  .modal-role {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 700; color: var(--text);
    background: var(--bg); border: 1.5px solid var(--border-soft);
    border-radius: 999px; padding: 4px 10px;
  }
  .modal-role .chip-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--chip-color, var(--accent)); }
  .modal-meta { display: flex; justify-content: center; gap: 18px; margin-top: 15px; }
  .modal-meta-item { text-align: center; }
  .modal-meta-label { font-size: 10.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .modal-meta-value { font-size: 13px; font-weight: 700; margin-top: 2px; }
  .modal-actions { display: flex; gap: 10px; margin-top: 22px; }
  .modal-actions .btn { flex: 1; justify-content: center; }
  .modal-note { color: var(--muted); font-size: 12.5px; font-weight: 600; margin-top: 14px; }

  /* tickets */
  .ticket-toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .ticket-toolbar .q-input { flex: 1 1 220px; }
  .ticket-list { display: flex; flex-direction: column; gap: 12px; }
  .ticket-item {
    background: var(--bg); border: 2px solid var(--border-soft); border-radius: 16px;
    padding: 15px 16px; cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .ticket-item:hover { transform: translateY(-2px); border-color: var(--accent-dark); }
  .ticket-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .ticket-id { font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 600; color: var(--muted); }
  .ticket-subject { font-size: 15px; font-weight: 800; margin-top: 3px; }
  .ticket-meta { color: var(--muted); font-size: 12.5px; font-weight: 700; margin-top: 7px; }
  .status-pill {
    font-size: 10.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
    border-radius: 999px; padding: 4px 10px; border: 1.5px solid var(--border); white-space: nowrap;
    color: var(--muted); background: var(--card);
  }
  .status-pill.status-open { color: var(--accent-dark); border-color: var(--accent); background: var(--accent-soft); }
  .status-pill.status-answered { color: #6b7f4a; border-color: #a8bd8a; background: rgba(140, 170, 110, 0.16); }
  .status-pill.status-closed { color: var(--muted); border-color: var(--border); background: var(--bg); }
  .ticket-detail { margin-top: 14px; border-top: 2px dashed var(--border-soft); padding-top: 14px; }
  .thread { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
  .reply { background: var(--bg); border: 2px solid var(--border-soft); border-radius: 14px; padding: 11px 14px; }
  .reply.staff { border-color: var(--accent); background: var(--accent-soft); }
  .reply-head { display: flex; justify-content: space-between; gap: 8px; font-size: 11.5px; font-weight: 800; color: var(--muted); }
  .reply-body { font-size: 14px; font-weight: 600; white-space: pre-wrap; word-break: break-word; margin-top: 5px; }
  .reply-form { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
  .empty-note { color: var(--muted); font-size: 14px; font-weight: 600; text-align: center; padding: 26px 10px; }

  .next-steps { display: flex; flex-direction: column; gap: 10px; margin: 18px 0; text-align: left; }
  .next-step { display: flex; gap: 11px; align-items: flex-start; background: var(--bg); border: 2px solid var(--border-soft); border-radius: 14px; padding: 12px 14px; }
  .next-step-num {
    font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 13px;
    width: 24px; height: 24px; flex: none; border-radius: 50%;
    background: var(--accent-soft); color: var(--accent-dark); border: 1.5px solid var(--accent);
    display: flex; align-items: center; justify-content: center;
  }
  .next-step-text { font-size: 13.5px; font-weight: 600; }
  .copy-strip {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    background: var(--bg); border: 2px solid var(--border); border-radius: 14px;
    padding: 12px 15px; margin: 0 auto 6px; max-width: 320px;
  }
  .copy-id { font-family: "JetBrains Mono", monospace; font-size: 17px; font-weight: 600; letter-spacing: 0.06em; }
  .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .info-card { background: var(--bg); border: 2px solid var(--border-soft); border-radius: 16px; padding: 16px; }
  .info-card h3 { font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 16px; margin-bottom: 6px; }
  .info-card p, .info-card li { color: var(--muted); font-size: 13.5px; font-weight: 600; }
  .info-card ul { padding-left: 18px; margin-top: 6px; }
  .info-card li { margin-bottom: 4px; }

  .toast {
    position: fixed; left: 50%; bottom: 26px; z-index: 70;
    transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
    background: var(--code-bg); color: var(--code-text);
    border-radius: 14px; padding: 11px 18px; font-size: 13.5px; font-weight: 700;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.25, 1), opacity 0.25s ease;
    max-width: 90vw; text-align: center;
  }
  .toast.visible { transform: translate(-50%, 0); opacity: 1; }

  @media (max-width: 560px) {
    .hub-grid { grid-template-columns: 1fr 1fr; }
    .hub-card { padding: 14px; }
    .hub-card-desc { display: none; }
    .panel { padding: 17px; }
    .modal-actions { flex-direction: column; }
    .wizard-nav { flex-direction: column-reverse; }
    .wizard-nav .btn { justify-content: center; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div class="brand"><span class="dot-brand"></span>bot command reference</div>
    <div class="topbar-actions">
      <button class="icon-btn" id="favoritesBtn" title="Show favorites only (F)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      </button>
      <button class="icon-btn" id="collapseBtn" title="Collapse other roles when opening one (C)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="12" x2="21" y2="12"></line></svg>
      </button>
      <button class="icon-btn" id="themeBtn" title="Toggle dark mode (D)">
        <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>
      <button class="icon-btn" id="expandAllBtn" title="Expand all (E)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg>
      </button>
    </div>
  </div>
  <div class="hub-intro">
    <h1 class="hub-title">member<span class="accent"> hub</span></h1>
    <p class="hub-sub">Get help, read the commands, and follow your tickets.</p>
  </div>

  <div class="hub-grid" id="hubGrid">
    <button class="hub-card" data-view="support">
