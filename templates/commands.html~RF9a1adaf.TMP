/* ============================================================
   STATE
   ============================================================ */
const state = {
  query: "",
  activeRoles: new Set(),
  favoritesOnly: false,
  favorites: new Set(JSON.parse(localStorage.getItem("cmdFavs") || "[]")),
  theme: localStorage.getItem("cmdTheme") || "light",
  sort: "default",
  collapseOthers: false,
  activeProfile: null
};

let USAGE_CACHE = {};
let MEMBERS_CACHE = null;

/* ============================================================
   SUPABASE FETCH
   ============================================================ */
async function supaFetch(path) {
  const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, {
    headers: {
      "apikey": SUPABASE_ANON_KEY,
      "Authorization": `Bearer ${SUPABASE_ANON_KEY}`
    }
  });
  if (!res.ok) throw new Error(`Supabase ${res.status}`);
  return res.json();
}

async function fetchUsage() {
  try {
    const rows = await supaFetch("command_usage?select=command_name,count");
    USAGE_CACHE = {};
    rows.forEach(r => { USAGE_CACHE[r.command_name] = r.count; });
  } catch (e) {
    console.warn("[usage] fetch failed", e);
  }
}

async function loadMembers() {
  if (MEMBERS_CACHE) return MEMBERS_CACHE;
  try {
    const rows = await supaFetch("members?select=user_id,username,display_name,avatar_url,banner_url,bio,roles,joined_at,created_at");
    MEMBERS_CACHE = rows;
    return rows;
  } catch (e) {
    console.warn("[members] fetch failed", e);
    MEMBERS_CACHE = [];
    return [];
  }
}

/* ============================================================
   BOOT
   ============================================================ */
document.documentElement.setAttribute("data-theme", state.theme);
updateThemeIcon();

const rolesEl = document.getElementById("roles");
const filtersEl = document.getElementById("filters");
const searchInput = document.getElementById("searchInput");
const searchWrap = document.getElementById("searchWrap");
const searchClear = document.getElementById("searchClear");
const resultsMeta = document.getElementById("resultsMeta");
const noResults = document.getElementById("noResults");
const statRoles = document.getElementById("statRoles");
const statCmds = document.getElementById("statCmds");
const statCmdsTotal = document.getElementById("statCmdsTotal");
const statFavs = document.getElementById("statFavs");

const profilePanel = document.getElementById("profilePanel");
const profileBackdrop = document.getElementById("profileBackdrop");
const profileContent = document.getElementById("profileContent");
const profileClose = document.getElementById("profileClose");

/* ============================================================
   RENDER ROLES
   ============================================================ */
let totalCommands = 0;
const uniqueCommands = new Set();

ROLES.forEach((role, i) => {
  totalCommands += role.commands.length;
  role.commands.forEach(c => {
    const base = c[0].split(" ")[0].replace(/[<>\[\]]/g, "");
    uniqueCommands.add(base);
  });

  const el = document.createElement("div");
  el.className = "role";
  el.dataset.roleName = role.name;
  el.style.setProperty("--role-color", role.color);
  el.style.setProperty("--role-color-soft", role.soft);
  el.style.setProperty("--i", i);

  const initial = role.name.charAt(0).toUpperCase();

  const header = document.createElement("div");
  header.className = "role-header";
  header.innerHTML = `
    <div class="role-left">
      <div class="badge">${initial}</div>
      <span class="role-name">${role.name}</span>
      <span class="count">${role.commands.length}</span>
    </div>
    <div class="role-actions">
      <button class="mini-btn expand-role-btn" title="Expand all in this role">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg>
      </button>
      <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </div>
  `;

  const body = document.createElement("div");
  body.className = "role-body";
  const bodyInner = document.createElement("div");
  bodyInner.className = "role-body-inner";
  const list = document.createElement("div");
  list.className = "cmd-list";

  role.commands.forEach((cmdArr, j) => {
    const [syntax, short, docs] = cmdArr;
    const wrap = document.createElement("div");
    wrap.className = "cmd-wrap";
    wrap.style.setProperty("--j", j);
    wrap.dataset.syntax = syntax.toLowerCase();
    wrap.dataset.short = short.toLowerCase();
    wrap.dataset.role = role.name;

    const favKey = `${role.name}::${syntax}`;
    wrap.dataset.favKey = favKey;

    if (state.favorites.has(favKey)) wrap.classList.add("favorite");

    const row = document.createElement("div");
    row.className = "cmd";
    row.innerHTML = `
      <code>&gt;${escapeHtml(syntax)}</code>
      <span class="cmd-desc">${escapeHtml(short)}</span>
      <button class="fav-btn" title="Favorite">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      </button>
      ${docs ? `<svg class="cmd-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>` : ""}
    `;

    wrap.appendChild(row);

    if (docs) {
      const docsEl = document.createElement("div");
      docsEl.className = "docs";
      const docsInner = document.createElement("div");
      docsInner.className = "docs-inner";
      const docsContent = document.createElement("div");
      docsContent.className = "docs-content";
      docsContent.innerHTML = buildDocs(docs, syntax);
      docsInner.appendChild(docsContent);
      docsEl.appendChild(docsInner);
      wrap.appendChild(docsEl);

      row.addEventListener("click", (e) => {
        if (e.target.closest(".fav-btn")) return;
        e.stopPropagation();
        wrap.classList.toggle("open");
      });
    }

    const favBtn = row.querySelector(".fav-btn");
    favBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleFavorite(favKey, wrap);
    });

    list.appendChild(wrap);
  });

  bodyInner.appendChild(list);
  body.appendChild(bodyInner);
  el.appendChild(header);
  el.appendChild(body);

  header.addEventListener("click", (e) => {
    if (e.target.closest(".expand-role-btn")) return;
    if (state.collapseOthers && !el.classList.contains("open")) {
      rolesEl.querySelectorAll(".role.open").forEach(r => {
        if (r !== el) r.classList.remove("open");
      });
    }
    el.classList.toggle("open");
  });

  header.querySelector(".expand-role-btn").addEventListener("click", (e) => {
    e.stopPropagation();
    el.classList.toggle("open");
    const open = el.classList.contains("open");
    list.querySelectorAll(".cmd-wrap").forEach(w => {
      if (w.querySelector(".docs")) {
        w.classList.toggle("open", open);
      }
    });
  });

  rolesEl.appendChild(el);
});

statRoles.textContent = ROLES.length;
statCmds.textContent = uniqueCommands.size;
statCmdsTotal.textContent = `(${totalCommands} total)`;
updateFavCount();

/* ============================================================
   SEARCH
   ============================================================ */
searchInput.addEventListener("input", async () => {
  const raw = searchInput.value.trim();
  state.query = raw.toLowerCase();
  searchClear.classList.toggle("visible", state.query.length > 0);

  const handled = await maybeLookupUser(raw);
  if (!handled) {
    applyFilters();
  }
});

searchInput.addEventListener("focus", () => searchWrap.classList.add("focused"));
searchInput.addEventListener("blur", () => searchWrap.classList.remove("focused"));

searchClear.addEventListener("click", () => {
  searchInput.value = "";
  state.query = "";
  searchClear.classList.remove("visible");
  applyFilters();
  searchInput.focus();
});

/* ============================================================
   ROLE FILTERS
   ============================================================ */
ROLES.forEach((role) => {
  const chip = document.createElement("button");
  chip.className = "filter-chip";
  chip.dataset.role = role.name;
  chip.style.setProperty("--chip-color", role.color);
  chip.style.setProperty("--chip-color-soft", role.soft);
  chip.innerHTML = `<span class="chip-dot"></span>${role.name}<span class="chip-count">${role.commands.length}</span>`;

  chip.addEventListener("click", () => {
    if (state.activeRoles.has(role.name)) {
      state.activeRoles.delete(role.name);
      chip.classList.remove("active");
    } else {
      state.activeRoles.add(role.name);
      chip.classList.add("active");
    }
    applyFilters();
  });

  filtersEl.appendChild(chip);
});

const sortBtn = document.createElement("button");
sortBtn.className = "sort-toggle";
sortBtn.innerHTML = `Sort: Default`;
sortBtn.addEventListener("click", () => {
  const order = ["default", "az", "za"];
  const idx = order.indexOf(state.sort);
  state.sort = order[(idx + 1) % order.length];
  sortBtn.innerHTML = `Sort: ${state.sort === "default" ? "Default" : state.sort === "az" ? "A → Z" : "Z → A"}`;
  applyFilters();
});
filtersEl.appendChild(sortBtn);

/* ============================================================
   FUZZY SEARCH
   ============================================================ */
function fuzzyMatch(needle, haystack) {
  if (!needle) return true;
  let ni = 0;
  for (let hi = 0; hi < haystack.length && ni < needle.length; hi++) {
    if (haystack[hi] === needle[ni]) ni++;
  }
  return ni === needle.length;
}

/* ============================================================
   FILTER LOGIC
   ============================================================ */
function applyFilters() {
  const q = state.query;
  let totalVisible = 0;
  const roleEls = Array.from(rolesEl.children);

  roleEls.forEach(roleEl => {
    const roleName = roleEl.dataset.roleName;
    const roleFiltered = state.activeRoles.size === 0 || state.activeRoles.has(roleName);
    const cmdWraps = Array.from(roleEl.querySelectorAll(".cmd-wrap"));
    let roleVisible = 0;

    cmdWraps.forEach(wrap => {
      const syntax = wrap.dataset.syntax;
      const short = wrap.dataset.short;
      const favMatch = !state.favoritesOnly || wrap.classList.contains("favorite");

      let queryMatch = true;
      if (q) {
        if (q.startsWith("@")) {
          const roleQuery = q.slice(1);
          queryMatch = roleName.toLowerCase().includes(roleQuery);
        } else {
          queryMatch = syntax.includes(q) || short.includes(q) ||
                       fuzzyMatch(q, syntax) || fuzzyMatch(q, short);
        }
      }

      const show = roleFiltered && queryMatch && favMatch;

      if (show) {
        wrap.classList.remove("hidden");
        highlightMatch(wrap, q);
        roleVisible++;
      } else {
        wrap.classList.add("hidden");
      }
    });

    if (roleVisible > 0 && (state.activeRoles.size === 0 || state.activeRoles.has(roleName)) && roleFiltered) {
      roleEl.classList.remove("hidden");
      totalVisible += roleVisible;
      if ((q || state.activeRoles.size > 0 || state.favoritesOnly) && !roleEl.classList.contains("open")) {
        roleEl.classList.add("open");
      }
    } else {
      roleEl.classList.add("hidden");
    }
  });

  noResults.classList.toggle("visible", totalVisible === 0);

  if (q || state.activeRoles.size > 0 || state.favoritesOnly) {
    resultsMeta.classList.remove("hidden");
    const filters = [];
    if (q) filters.push(`matching "<strong>${escapeHtml(state.query)}</strong>"`);
    if (state.activeRoles.size > 0) filters.push(`in <strong>${Array.from(state.activeRoles).join(", ")}</strong>`);
    if (state.favoritesOnly) filters.push(`in <strong>favorites</strong>`);
    resultsMeta.innerHTML = `Showing <strong>${totalVisible}</strong> command${totalVisible === 1 ? "" : "s"} ${filters.join(" ")} <span class="clear-search" id="clearAllFilters">clear</span>`;
    const clearAll = document.getElementById("clearAllFilters");
    if (clearAll) {
      clearAll.addEventListener("click", () => {
        searchInput.value = "";
        state.query = "";
        searchClear.classList.remove("visible");
        state.activeRoles.clear();
        filtersEl.querySelectorAll(".filter-chip").forEach(c => c.classList.remove("active"));
        state.favoritesOnly = false;
        document.getElementById("favoritesBtn").classList.remove("active");
        applyFilters();
      });
    }
  } else {
    resultsMeta.classList.add("hidden");
  }

  if (state.sort !== "default") {
    roleEls.forEach(roleEl => {
      const list = roleEl.querySelector(".cmd-list");
      const wraps = Array.from(list.children);
      wraps.sort((a, b) => {
        const aS = a.dataset.syntax, bS = b.dataset.syntax;
        return state.sort === "az" ? aS.localeCompare(bS) : bS.localeCompare(aS);
      });
      wraps.forEach(w => list.appendChild(w));
    });
  } else {
    roleEls.forEach(roleEl => {
      const list = roleEl.querySelector(".cmd-list");
      const wraps = Array.from(list.children);
      wraps.sort((a, b) => parseInt(a.style.getPropertyValue("--j") || 0) - parseInt(b.style.getPropertyValue("--j") || 0));
      wraps.forEach(w => list.appendChild(w));
    });
  }
}

function highlightMatch(wrap, q) {
  const descEl = wrap.querySelector(".cmd-desc");
  const original = wrap.dataset.short;
  if (!q || q.startsWith("@")) {
    descEl.innerHTML = escapeHtml(original);
    return;
  }
  const idx = original.toLowerCase().indexOf(q);
  if (idx === -1) {
    descEl.innerHTML = escapeHtml(original);
    return;
  }
  const before = original.slice(0, idx);
  const match = original.slice(idx, idx + q.length);
  const after = original.slice(idx + q.length);
  descEl.innerHTML = `${escapeHtml(before)}<mark>${escapeHtml(match)}</mark>${escapeHtml(after)}`;
}

/* ============================================================
   FAVORITES
   ============================================================ */
function toggleFavorite(favKey, wrap) {
  if (state.favorites.has(favKey)) {
    state.favorites.delete(favKey);
    wrap.classList.remove("favorite");
  } else {
    state.favorites.add(favKey);
    wrap.classList.add("favorite");
  }
  localStorage.setItem("cmdFavs", JSON.stringify(Array.from(state.favorites)));
  updateFavCount();
  if (state.favoritesOnly) applyFilters();
}

function updateFavCount() {
  statFavs.textContent = state.favorites.size;
}

document.getElementById("favoritesBtn").addEventListener("click", () => {
  state.favoritesOnly = !state.favoritesOnly;
  document.getElementById("favoritesBtn").classList.toggle("active", state.favoritesOnly);
  applyFilters();
});

/* ============================================================
   THEME
   ============================================================ */
function updateThemeIcon() {
  const icon = document.getElementById("themeIcon");
  if (state.theme === "dark") {
    icon.innerHTML = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>`;
  } else {
    icon.innerHTML = `<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>`;
  }
}

document.getElementById("themeBtn").addEventListener("click", () => {
  state.theme = state.theme === "light" ? "dark" : "light";
  document.documentElement.setAttribute("data-theme", state.theme);
  localStorage.setItem("cmdTheme", state.theme);
  updateThemeIcon();
});

/* ============================================================
   COLLAPSE OTHERS
   ============================================================ */
document.getElementById("collapseBtn").addEventListener("click", () => {
  state.collapseOthers = !state.collapseOthers;
  document.getElementById("collapseBtn").classList.toggle("active", state.collapseOthers);
});

/* ============================================================
   EXPAND ALL
   ============================================================ */
let allExpanded = false;
document.getElementById("expandAllBtn").addEventListener("click", () => {
  allExpanded = !allExpanded;
  rolesEl.querySelectorAll(".role").forEach(r => {
    if (allExpanded) r.classList.add("open");
    else r.classList.remove("open");
  });
  rolesEl.querySelectorAll(".cmd-wrap").forEach(w => {
    if (w.querySelector(".docs")) {
      w.classList.toggle("open", allExpanded);
    }
  });
});

/* ============================================================
   KEYBOARD
   ============================================================ */
document.addEventListener("keydown", (e) => {
  const typing = ["INPUT", "TEXTAREA", "SELECT"].includes(((document.activeElement || {}).tagName || ""));
  const commandsVisible = !document.getElementById("view-commands").hidden;
  if (e.key === "/" && !typing && commandsVisible && document.activeElement !== searchInput) {
    e.preventDefault();
    searchInput.focus();
  }
  if (e.key === "Escape") {
    if (state.activeProfile) {
      closeProfile();
      return;
    }
    if (document.activeElement === searchInput) {
      searchInput.value = "";
      state.query = "";
      searchClear.classList.remove("visible");
      applyFilters();
      searchInput.blur();
    }
  }
  if (document.activeElement !== searchInput) {
    const k = e.key.toLowerCase();
    if (k === "d") document.getElementById("themeBtn").click();
    if (k === "e") document.getElementById("expandAllBtn").click();
    if (k === "f") document.getElementById("favoritesBtn").click();
    if (k === "c") document.getElementById("collapseBtn").click();
  }
});

/* ============================================================
   SCROLL TOP
   ============================================================ */
const scrollTopBtn = document.getElementById("scrollTop");
window.addEventListener("scroll", () => {
  scrollTopBtn.classList.toggle("visible", window.scrollY > 400);
}, { passive: true });
scrollTopBtn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

/* ============================================================
   HELPERS
   ============================================================ */
function escapeHtml(str) {
  return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function renderInlineCode(text) {
  return escapeHtml(text).replace(/`([^`]+)`/g, "<code>$1</code>");
}

function highlightExample(line) {
  let out = escapeHtml(line);
  out = out.replace(/(&gt;)(\w+)/g, '<span class="tok-bot">$1</span><span class="tok-cmd">$2</span>');
  out = out.replace(/(&lt;[^&]+&gt;)/g, '<span class="tok-arg">$1</span>');
  out = out.replace(/(\[[^\]]+\])/g, '<span class="tok-opt">$1</span>');
  return out;
}

function buildDocs(docs, syntax) {
  const parts = [];

  if (docs.how) parts.push(`<h4>How to Use</h4><p>${renderInlineCode(docs.how)}</p>`);

  if (docs.args && docs.args.length) {
    parts.push(`<h4>Arguments</h4><ul>`);
    docs.args.forEach(([name, desc, kind]) => {
      const tag = kind === "required" ? '<span class="label req">required</span>' : '<span class="label opt">optional</span>';
      parts.push(`<li>${tag}<code>${escapeHtml(name)}</code> — ${renderInlineCode(desc)}</li>`);
    });
    parts.push(`</ul>`);
  }

  if (docs.ex && docs.ex.length) {
    parts.push(`<h4>Examples</h4>`);
    const html = docs.ex.map(highlightExample).join("\n");
    parts.push(`<pre>${html}<button class="copy-btn" data-copy="${escapeHtml(docs.ex.join("\n"))}">Copy</button></pre>`);
  }

  if (docs.use) parts.push(`<h4>Use Case</h4><p>${renderInlineCode(docs.use)}</p>`);

  if (docs.notes && docs.notes.length) {
    parts.push(`<h4>Notes</h4><ul>`);
    docs.notes.forEach(n => parts.push(`<li>${renderInlineCode(n)}</li>`));
    parts.push(`</ul>`);
  }

  const base = syntax.split(" ")[0].replace(/[<>\[\]]/g, "");
  const count = USAGE_CACHE[base] || 0;
  parts.push(`<div class="run-count" data-cmd="${escapeHtml(base)}"><span class="pulse-dot"></span>Run count: ${count.toLocaleString()}</div>`);

  return parts.join("");
}

/* ============================================================
   COPY
   ============================================================ */
document.addEventListener("click", (e) => {
  const btn = e.target.closest(".copy-btn");
  if (!btn) return;
  e.stopPropagation();
  const text = btn.dataset.copy;
  navigator.clipboard.writeText(text).then(() => {
    btn.textContent = "Copied!";
    btn.classList.add("copied");
    setTimeout(() => { btn.textContent = "Copy"; btn.classList.remove("copied"); }, 1400);
  });
});

/* ============================================================
   USER LOOKUP + PROFILE PANEL
   ============================================================ */
async function maybeLookupUser(q) {
  if (!q) return false;
  const isMention = q.startsWith("@");
  const isUid = /^\d{15,}$/.test(q);
  if (!isMention && !isUid) return false;

  const members = await loadMembers();
  const needle = isMention ? q.slice(1).toLowerCase() : q;

  const match = members.find(m => {
    if (isUid) return m.user_id === needle;
    return (m.username || "").toLowerCase() === needle || (m.display_name || "").toLowerCase() === needle;
  });

  if (!match) {
    showProfileEmpty(needle, isUid);
    return true;
  }

  openProfile(match);
  return true;
}

function closeProfile() {
  profilePanel.classList.remove("visible");
  profileBackdrop.classList.remove("visible");
  state.activeProfile = null;
}

profileClose.addEventListener("click", closeProfile);
profileBackdrop.addEventListener("click", closeProfile);

function showProfileEmpty(query, isUid) {
  profileContent.innerHTML = `
    <div class="profile-empty" style="padding-top: 140px;">
      <div class="profile-empty-title">No member found</div>
      <div style="font-size: 13px;">${isUid ? "No member with UID" : "No member named"} <strong>${escapeHtml(query)}</strong> is in this server.</div>
    </div>
  `;
  profilePanel.classList.add("visible");
  profileBackdrop.classList.add("visible");
  state.activeProfile = { empty: true };
}

function openProfile(member) {
  state.activeProfile = member;

  const roles = member.roles || [];
  const highest = roles.reduce((a, b) => (a.tier > b.tier ? a : b), { tier: -1, name: "Members", color: "#96908a" });

  const bannerStyle = member.banner_url ? `background-image: url('${member.banner_url}');` : "";
  const joinedDate = member.joined_at ? new Date(member.joined_at).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" }) : "Unknown";
  const createdDate = member.created_at ? new Date(member.created_at).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" }) : "Unknown";

  const roleChips = roles
    .slice()
    .sort((a, b) => b.tier - a.tier)
    .map(r => `<span class="profile-role-chip" style="--chip-color: ${escapeHtml(r.color)};"><span class="chip-dot"></span>${escapeHtml(r.name)}</span>`)
    .join("");

  profileContent.innerHTML = `
    <div class="profile-banner" style="${bannerStyle}"></div>
    <div class="profile-avatar-wrap">
      <img class="profile-avatar" src="${escapeHtml(member.avatar_url || '')}" alt="">
      <span class="profile-status-dot"></span>
    </div>
    <div class="profile-body">
      <div class="profile-name">${escapeHtml(member.display_name || member.username)}</div>
      <div class="profile-handle">@${escapeHtml(member.username)}</div>

      <div class="profile-bio ${member.bio ? '' : 'empty'}">
        ${member.bio ? escapeHtml(member.bio) : "No bio available."}
      </div>

      <div class="profile-section-title">Roles (${roles.length})</div>
      <div class="profile-roles">${roleChips || '<span style="color: var(--muted); font-size: 13px;">No roles</span>'}</div>

      <div class="profile-meta">
        <div class="profile-meta-row">
          <span class="profile-meta-label">User ID</span>
          <span class="profile-meta-value">${escapeHtml(member.user_id)}</span>
        </div>
        <div class="profile-meta-row">
          <span class="profile-meta-label">Joined</span>
          <span class="profile-meta-value">${escapeHtml(joinedDate)}</span>
        </div>
        <div class="profile-meta-row">
          <span class="profile-meta-label">Account Created</span>
          <span class="profile-meta-value">${escapeHtml(createdDate)}</span>
        </div>
        <div class="profile-meta-row">
          <span class="profile-meta-label">Highest Role</span>
          <span class="profile-meta-value" style="color: ${escapeHtml(highest.color)};">${escapeHtml(highest.name)}</span>
        </div>
      </div>

      <button class="profile-view-cmds" id="profileViewCmds">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 11 12 14 22 4"></polyline>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
        </svg>
        View Their Commands
      </button>
    </div>
  `;

  profilePanel.classList.add("visible");
  profileBackdrop.classList.add("visible");

  document.getElementById("profileViewCmds").addEventListener("click", () => {
    viewMemberCommands(member);
  });
}

function viewMemberCommands(member) {
  closeProfile();

  const roleNames = (member.roles || []).map(r => r.name);
  if (roleNames.length === 0) roleNames.push("Members");

  state.activeRoles = new Set(roleNames);
  filtersEl.querySelectorAll(".filter-chip").forEach(chip => {
    chip.classList.toggle("active", state.activeRoles.has(chip.dataset.role));
  });

  searchInput.value = "";
  state.query = "";
  searchClear.classList.remove("visible");

  applyFilters();

  window.scrollTo({ top: 0, behavior: "smooth" });

  resultsMeta.innerHTML = `Showing commands available to <strong>${escapeHtml(member.display_name || member.username)}</strong> (${roleNames.join(", ")}) <span class="clear-search" id="clearAllFilters">clear</span>`;
  resultsMeta.classList.remove("hidden");
  const clearAll = document.getElementById("clearAllFilters");
  if (clearAll) {
    clearAll.addEventListener("click", () => {
      state.activeRoles.clear();
      filtersEl.querySelectorAll(".filter-chip").forEach(c => c.classList.remove("active"));
      applyFilters();
    });
  }
}

if (location.hash) {
  const hash = decodeURIComponent(location.hash.slice(1));
  searchInput.value = hash;
  state.query = hash.toLowerCase();
  searchClear.classList.add("visible");
}

applyFilters();

(async () => {
  await Promise.all([fetchUsage(), loadMembers()]);
  document.querySelectorAll(".run-count").forEach(el => {
    const cmd = el.dataset.cmd;
    const count = USAGE_CACHE[cmd] || 0;
    el.innerHTML = `<span class="pulse-dot"></span>Run count: ${count.toLocaleString()}`;
  });
})();

/* ============================================================
   MEMBER HUB
   ============================================================ */
const HUB_DRAFT_KEY = "memberhub.draft.v1";

const ICON = {
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>',
  alert: '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line>',
  bug: '<path d="m8 2 1.88 1.88"></path><path d="M14.12 3.88 16 2"></path><path d="M9 7.13v-1a3 3 0 0 1 6 0v1"></path><rect x="6" y="9" width="12" height="8" rx="4"></rect><path d="M6 11H3"></path><path d="M18 11h3"></path><path d="M6 15H3"></path><path d="M18 15h3"></path><path d="M12 17v3"></path>',
  scale: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line>',
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"></path>',
  left: '<line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>',
  right: '<line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>',
  send: '<line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>',
  copy: '<rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>',
  check: '<polyline points="20 6 9 17 4 12"></polyline>',
  x: '<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>'
};

function icon(name) {
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICON[name] || ""}</svg>`;
}

const WHEN_OPTIONS = ["Today", "In the last few days", "Last week", "Longer ago", "Not sure"];

const TICKET_TOPICS = [
  {
    id: "account", label: "Account help", icon: "user",
    questions: [
      { key: "What do you need help with?", type: "select", options: ["I cannot log in", "I lost my account", "A role is missing", "I want a name change", "Something else"] },
      { key: "Which account name do you use?", type: "text", placeholder: "Your Discord name", required: true }
    ]
  },
  {
    id: "report", label: "Report a user", icon: "alert",
    questions: [
      { key: "Who are you reporting?", type: "text", hint: "Their username or user ID.", placeholder: "example or 123456789012345678", required: true },
      { key: "What did they do?", type: "textarea", hint: "Keep it to the facts.", max: 1200, required: true }
    ]
  },
  {
    id: "bug", label: "Report a bug", icon: "bug",
    questions: [
      { key: "Where did you see the bug?", type: "select", options: ["Discord server", "This website", "A bot command", "Somewhere else"] },
      { key: "What did you expect to happen?", type: "textarea", max: 800, required: true },
      { key: "What happened instead?", type: "textarea", max: 800, required: true }
    ]
  },
  {
    id: "appeal", label: "Appeal a punishment", icon: "scale",
    questions: [
      { key: "Which punishment?", type: "select", options: ["Warning", "Mute or timeout", "Kick", "Ban", "I am not sure"] },
      { key: "Do you know your case ID?", type: "text", placeholder: "Optional", required: false },
      { key: "Why should we undo it?", type: "textarea", hint: "Tell us what you think we missed.", max: 1200, required: true }
    ]
  },
  {
    id: "shop", label: "Payment or shop", icon: "card",
    questions: [
      { key: "What did you buy?", type: "text", required: true },
      { key: "Order or payment ID", type: "text", placeholder: "Optional", required: false },
      { key: "What went wrong?", type: "textarea", max: 1000, required: true }
    ]
  },
  {
    id: "other", label: "Something else", icon: "chat",
    questions: [
      { key: "What is this about?", type: "text", placeholder: "A few words", required: true }
    ]
  }
];

const COMMON_QUESTIONS = [
  { key: "When did this happen?", type: "select", options: WHEN_OPTIONS },
  { key: "What happened?", type: "textarea", hint: "Tell us in your own words. Short and clear is fine.", max: 1500, required: true },
  { key: "Do you have links or proof?", type: "textarea", hint: "Optional. Paste links to screenshots, messages, or anything that helps.", max: 800, required: false },
  { key: "How urgent is this?", type: "select", options: ["Low", "Normal", "High"] }
];

const hub = {
  view: "support",
  topic: null,
  step: 0,
  answers: {},
  user: null,
  lookupUser: null,
  tickets: {},
  busy: false
};

const supportStart = document.getElementById("supportStart");
const supportWizard = document.getElementById("supportWizard");
const supportDone = document.getElementById("supportDone");
const topicGrid = document.getElementById("topicGrid");
const confirmModal = document.getElementById("confirmModal");
const confirmBackdrop = document.getElementById("confirmBackdrop");
const ticketListWrap = document.getElementById("ticketListWrap");
const ticketLookup = document.getElementById("ticketLookup");
const ticketLookupError = document.getElementById("ticketLookupError");
let confirmResolver = null;

/* ---------- views ---------- */
function showView(name) {
  if (!document.getElementById("view-" + name)) name = "support";
  document.querySelectorAll(".view").forEach(v => { v.hidden = v.id !== "view-" + name; });
  document.querySelectorAll("[data-view]").forEach(b => b.classList.toggle("active", b.dataset.view === name));
  hub.view = name;
  window.scrollTo({ top: 0, behavior: "smooth" });
}

document.addEventListener("click", (e) => {
  const btn = e.target.closest("[data-view]");
  if (btn) showView(btn.dataset.view);
});

/* ---------- toast ---------- */
let toastTimer = null;
function toast(message) {
  const el = document.getElementById("toast");
  el.textContent = message;
  el.classList.add("visible");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove("visible"), 2800);
}

/* ---------- confirm popup ---------- */
function askConfirm(user) {
  document.getElementById("confirmAvatar").src = user.avatar_url || "";
  document.getElementById("confirmName").textContent = user.display_name || user.username || "Unknown member";
  document.getElementById("confirmHandle").textContent = user.username ? "@" + user.username : "no username on file";
  document.getElementById("confirmRoles").innerHTML = (user.roles || []).slice(0, 6).map(r =>
    `<span class="modal-role" style="--chip-color: ${escapeHtml(r.color || "#6ea8c9")}"><span class="chip-dot"></span>${escapeHtml(r.name)}</span>`
  ).join("");
  const joined = user.joined_at ? new Date(user.joined_at).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" }) : "Unknown";
  document.getElementById("confirmMeta").innerHTML = `
    <div class="modal-meta-item"><div class="modal-meta-label">User ID</div><div class="modal-meta-value">${escapeHtml(user.user_id || "-")}</div></div>
    <div class="modal-meta-item"><div class="modal-meta-label">Joined</div><div class="modal-meta-value">${escapeHtml(joined)}</div></div>`;
  confirmModal.classList.add("open");
  confirmBackdrop.classList.add("visible");
  return new Promise(resolve => { confirmResolver = resolve; });
}

function closeConfirm(value) {
  confirmModal.classList.remove("open");
  confirmBackdrop.classList.remove("visible");
  const resolve = confirmResolver;
  confirmResolver = null;
  if (resolve) resolve(value);
}

document.getElementById("confirmYes").addEventListener("click", () => closeConfirm(true));
document.getElementById("confirmNo").addEventListener("click", () => closeConfirm(false));
confirmBackdrop.addEventListener("click", () => closeConfirm(false));
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && confirmResolver) {
    e.stopPropagation();
    closeConfirm(false);
  }
}, true);

/* ---------- identity ---------- */
async function resolveIdentity(value) {
  const raw = (value || "").trim();
  if (!raw) return { ok: false, error: "Type your username or user ID." };
  const isUid = /^\d{15,}$/.test(raw);
  const needle = (raw.startsWith("@") ? raw.slice(1) : raw).toLowerCase();
  const members = await loadMembers();
  let match = null;
  if (isUid) {
    match = members.find(m => String(m.user_id) === raw);
  } else {
    match = members.find(m => (m.username || "").toLowerCase() === needle)
      || members.find(m => (m.display_name || "").toLowerCase() === needle);
  }
  if (match) return { ok: true, user: match };
  if (isUid) return { ok: true, user: { user_id: raw, username: "", display_name: "User " + raw } };
  return { ok: false, error: "We could not find that name. Try your user ID, or check the spelling." };
}

/* ---------- wizard ---------- */
function wizardSteps() {
  const topic = TICKET_TOPICS.find(t => t.id === hub.topic) || { questions: [] };
  return [
    { key: "__identity", label: "Your username or user ID", hint: "This is the first thing we check. Type the name you use here, or paste your user ID.", type: "text", placeholder: "@yourname or 123456789012345678", required: true },
    { key: "__title", label: "Give your ticket a short title", hint: "A few words we can scan in the list.", type: "text", placeholder: "Cannot post in chat", required: true, max: 120 },
    ...topic.questions,
    ...COMMON_QUESTIONS
  ];
}

function renderTopics() {
  topicGrid.innerHTML = TICKET_TOPICS.map(t => `
    <button class="topic" data-topic="${t.id}">
      ${icon(t.icon)}
      ${escapeHtml(t.label)}
    </button>`).join("");
}

topicGrid.addEventListener("click", (e) => {
  const btn = e.target.closest("[data-topic]");
  if (!btn) return;
  startTicket(btn.dataset.topic);
});

function saveDraft() {
  try {
    localStorage.setItem(HUB_DRAFT_KEY, JSON.stringify({ topic: hub.topic, step: hub.step, answers: hub.answers }));
  } catch (err) { /* storage full or blocked */ }
}

function clearDraft() {
  try { localStorage.removeItem(HUB_DRAFT_KEY); } catch (err) { /* nothing to do */ }
}

function startTicket(topicId) {
  hub.topic = topicId;
  hub.step = 0;
  hub.answers = {};
  hub.user = null;
  supportStart.hidden = true;
  supportDone.hidden = true;
  supportWizard.hidden = false;
  renderWizard();
}

function restartTickets() {
  hub.topic = null;
  hub.step = 0;
  hub.answers = {};
  hub.user = null;
  supportWizard.hidden = true;
  supportDone.hidden = true;
  supportStart.hidden = false;
  clearDraft();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function currentStep() {
  return wizardSteps()[hub.step] || null;
}

function renderWizard() {
  const steps = wizardSteps();
  const step = steps[hub.step];
  const total = steps.length;

  if (!step) {
    renderReview(steps);
    return;
  }

  const value = hub.answers[step.key] || "";
  const pct = Math.round((hub.step / total) * 100);

  let field;
  if (step.type === "select") {
    field = `<select class="q-select" id="qField">${["Choose one", ...step.options].map(o =>
      `<option value="${escapeHtml(o)}" ${value === o ? "selected" : ""}>${escapeHtml(o)}</option>`).join("")}</select>`;
  } else if (step.type === "textarea") {
    field = `<textarea class="q-textarea" id="qField" maxlength="${step.max || 2000}" placeholder="${escapeHtml(step.placeholder || "Write here")}">${escapeHtml(value)}</textarea>
      <div class="counter" id="qCounter">${value.length} / ${step.max || 2000}</div>`;
  } else {
    field = `<input class="q-input" id="qField" maxlength="${step.max || 200}" placeholder="${escapeHtml(step.placeholder || "")}" value="${escapeHtml(value)}" autocomplete="off" spellcheck="false">`;
  }

  supportWizard.innerHTML = `
    <div class="wizard-top">
      <span class="step-label">Question ${hub.step + 1} of ${total}</span>
      <button class="btn small ghost" id="qQuit">${icon("x")} Stop</button>
    </div>
    <div class="progress-track"><div class="progress-fill" style="width: ${pct}%"></div></div>
    <div class="q-label">${escapeHtml(step.label)}</div>
    ${step.hint ? `<div class="q-hint">${escapeHtml(step.hint)}</div>` : ""}
    ${field}
    <div class="q-error" id="qError"></div>
    <div class="wizard-nav">
      <button class="btn ghost" id="qBack">${icon("left")} Back</button>
      <button class="btn primary" id="qNext">Next ${icon("right")}</button>
    </div>`;

  const fieldEl = document.getElementById("qField");
  fieldEl.focus();
  fieldEl.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && step.type !== "textarea") {
      e.preventDefault();
      nextStep();
    }
  });
  if (step.type === "textarea") {
    fieldEl.addEventListener("input", () => {
      const counter = document.getElementById("qCounter");
      if (counter) counter.textContent = `${fieldEl.value.length} / ${step.max || 2000}`;
    });
  }
  document.getElementById("qBack").addEventListener("click", backStep);
  document.getElementById("qNext").addEventListener("click", nextStep);
  document.getElementById("qQuit").addEventListener("click", () => {
    if (confirm("Stop this ticket? Your answers are kept in this browser.")) restartTickets();
  });
}

function showStepError(message) {
  const el = document.getElementById("qError");
  if (!el) return;
  el.textContent = message;
  el.classList.add("visible");
}

async function nextStep() {
  const step = currentStep();
  if (!step || hub.busy) return;
  const fieldEl = document.getElementById("qField");
  const value = (fieldEl.value || "").trim();

  if (step.required && !value) {
    showStepError("This one is needed. Please add an answer.");
    return;
  }
  if (step.type === "select" && value === "Choose one") {
    showStepError("Please pick one from the list.");
    return;
  }

  if (step.key === "__identity") {
    hub.busy = true;
    fieldEl.disabled = true;
    const found = await resolveIdentity(value);
    hub.busy = false;
    fieldEl.disabled = false;
    if (!found.ok) {
      showStepError(found.error);
      return;
    }
    const yes = await askConfirm(found.user);
    if (!yes) {
      showStepError("No problem. Check the name or ID and try again.");
      return;
    }
    hub.user = found.user;
    hub.answers[step.key] = value;
    hub.answers["__username"] = found.user.username || "";
    hub.step += 1;
    saveDraft();
    renderWizard();
    return;
  }

  hub.answers[step.key] = value;
  hub.step += 1;
  saveDraft();
  renderWizard();
}

function backStep() {
  if (hub.step === 0) {
    restartTickets();
    return;
  }
  hub.step -= 1;
  renderWizard();
}

function renderReview(steps) {
  const topic = TICKET_TOPICS.find(t => t.id === hub.topic);
  const rows = steps.filter(s => s.key !== "__identity").map((s, index) => {
    const stepIndex = steps.indexOf(s);
    return `
      <div class="review-row">
        <div class="review-head">
          <span class="review-key">${escapeHtml(s.label)}</span>
          <button class="jump" data-jump="${stepIndex}">change</button>
        </div>
        <div class="review-val">${escapeHtml(hub.answers[s.key] || "-")}</div>
      </div>`;
  }).join("");

  supportWizard.innerHTML = `
    <div class="wizard-top">
      <span class="step-label">Last check</span>
      <button class="btn small ghost" id="qQuit">${icon("x")} Stop</button>
    </div>
    <div class="progress-track"><div class="progress-fill" style="width: 100%"></div></div>
    <div class="q-label">Does this look right?</div>
    <div class="q-hint">Ticket topic: ${escapeHtml(topic ? topic.label : "Support")}. You can change any answer before sending.</div>
    <div class="review-list">${rows}</div>
    <div class="q-error" id="qError"></div>
    <div class="wizard-nav">
      <button class="btn ghost" id="qBack">${icon("left")} Back</button>
      <button class="btn primary" id="qSend">${icon("send")} Send ticket</button>
    </div>`;

  document.getElementById("qBack").addEventListener("click", backStep);
  document.getElementById("qQuit").addEventListener("click", () => {
    if (confirm("Stop this ticket? Your answers are kept in this browser.")) restartTickets();
  });
  document.getElementById("qSend").addEventListener("click", sendTicket);
  supportWizard.querySelectorAll("[data-jump]").forEach(btn => {
    btn.addEventListener("click", () => {
      hub.step = parseInt(btn.dataset.jump, 10);
      renderWizard();
    });
  });
}

async function sendTicket() {
  if (hub.busy) return;
  if (!hub.user) {
    const found = await resolveIdentity(hub.answers["__identity"] || "");
    if (found.ok) hub.user = found.user;
  }
  if (!hub.user) {
    showStepError("We lost who you are. Go back to the first question.");
    return;
  }
  const sendBtn = document.getElementById("qSend");
  hub.busy = true;
  sendBtn.disabled = true;
  sendBtn.textContent = "Sending...";

  const answers = {};
  Object.entries(hub.answers).forEach(([key, value]) => {
    if (!key.startsWith("__") && value) answers[key] = value;
  });
  const urgency = (hub.answers["How urgent is this?"] || "Normal").toLowerCase();

  try {
    const res = await fetch("/api/tickets", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        user_id: hub.user.user_id,
        username: hub.user.username || "",
        display_name: hub.user.display_name || "",
        avatar_url: hub.user.avatar_url || "",
        category: hub.topic,
        subject: hub.answers["__title"] || "",
        priority: urgency,
        answers: answers
      })
    });
    const data = await res.json();
    if (!res.ok || data.status !== "ok") throw new Error(data.message || "We could not send your ticket.");
    clearDraft();
    showTicketDone(data.ticket);
  } catch (err) {
    hub.busy = false;
    sendBtn.disabled = false;
    sendBtn.innerHTML = `${icon("send")} Send ticket`;
    showStepError(err.message || "Something went wrong. Please try again.");
  }
}

function showTicketDone(ticket) {
  hub.busy = false;
  supportWizard.hidden = true;
  supportDone.hidden = false;
  supportDone.innerHTML = `
    <div class="panel-title">Ticket sent</div>
    <p class="panel-sub">A staff member will read this and answer you here.</p>
    <div class="copy-strip">
      <span class="copy-id" id="doneId">${escapeHtml(ticket.id)}</span>
      <button class="btn small" id="copyId">${icon("copy")} Copy</button>
    </div>
    <div class="next-steps">
      <div class="next-step"><span class="next-step-num">1</span><span class="next-step-text">Your ticket is now in the staff list with the number ${escapeHtml(ticket.id)}.</span></div>
      <div class="next-step"><span class="next-step-num">2</span><span class="next-step-text">A reply usually comes within 24 hours.</span></div>
      <div class="next-step"><span class="next-step-num">3</span><span class="next-step-text">Open My tickets with the same name to read the answer and write back.</span></div>
    </div>
    <div class="wizard-nav">
      <button class="btn ghost" id="doneAgain">Open another ticket</button>
      <button class="btn primary" id="doneMine">Go to my tickets</button>
    </div>`;
  document.getElementById("copyId").addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(ticket.id);
      toast("Ticket number copied.");
    } catch (err) {
      toast("Copy did not work. Write it down instead.");
    }
  });
  document.getElementById("doneAgain").addEventListener("click", restartTickets);
  document.getElementById("doneMine").addEventListener("click", () => {
    const name = hub.user ? (hub.user.username || hub.user.user_id) : "";
    restartTickets();
    showView("tickets");
    ticketLookup.value = hub.lookupValue || name;
    lookupTickets();
  });
}

/* ---------- my tickets ---------- */
function formatDate(iso) {
  if (!iso) return "-";
  try {
    return new Date(iso).toLocaleString(undefined, { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
  } catch (err) {
    return iso;
  }
}

function statusLabel(status) {
  if (status === "answered") return "answered";
  if (status === "closed") return "closed";
  return "open";
}

document.getElementById("ticketLookupBtn").addEventListener("click", lookupTickets);
ticketLookup.addEventListener("keydown", (e) => { if (e.key === "Enter") lookupTickets(); });

async function lookupTickets() {
  const raw = (ticketLookup.value || "").trim();
  hub.lookupValue = raw;
  ticketLookupError.classList.remove("visible");
  if (!raw) {
    ticketLookupError.textContent = "Add your username or user ID first.";
    ticketLookupError.classList.add("visible");
    return;
  }
  ticketListWrap.innerHTML = '<div class="empty-note">Looking up your tickets...</div>';

  const found = await resolveIdentity(raw);
  if (!found.ok) {
    ticketListWrap.innerHTML = '<div class="empty-note">Nothing loaded yet.</div>';
    ticketLookupError.textContent = found.error;
    ticketLookupError.classList.add("visible");
    return;
  }
  hub.lookupUser = found.user;

  try {
    const res = await fetch(`/api/tickets?user_id=${encodeURIComponent(found.user.user_id)}`);
    const data = await res.json();
    if (!res.ok || data.status !== "ok") throw new Error(data.message || "Lookup failed.");
    hub.tickets = {};
    data.tickets.forEach(t => { hub.tickets[t.id] = t; });
    renderTicketList(data.tickets, found.user);
    updateBadge(data.open_count);
  } catch (err) {
    ticketListWrap.innerHTML = '<div class="empty-note">Could not load your tickets right now.</div>';
  }
}

function updateBadge(count) {
  const badge = document.getElementById("openTicketBadge");
  if (!badge) return;
  if (count > 0) {
    badge.textContent = `${count} open`;
    badge.hidden = false;
  } else {
    badge.hidden = true;
  }
}

function renderTicketList(tickets, user) {
  if (!tickets.length) {
    ticketListWrap.innerHTML = `<div class="empty-note">No tickets for ${escapeHtml(user.display_name || user.username || user.user_id)} yet. Open one from the Support page.</div>`;
    return;
  }
  ticketListWrap.innerHTML = `<div class="ticket-list">${tickets.map(ticketItemHtml).join("")}</div>`;
  if (hub.openTicket && hub.tickets[hub.openTicket]) {
    const item = ticketListWrap.querySelector(`.ticket-item[data-ticket="${hub.openTicket}"]`);
    if (item) {
      const detail = item.querySelector(".ticket-detail");
      detail.innerHTML = ticketDetailHtml(hub.tickets[hub.openTicket]);
      detail.hidden = false;
    }
  }
}

function ticketItemHtml(t) {
  return `
    <div class="ticket-item" data-ticket="${escapeHtml(t.id)}">
      <div class="ticket-row">
        <div>
          <div class="ticket-id">${escapeHtml(t.id)}</div>
          <div class="ticket-subject">${escapeHtml(t.subject || t.category_label || "Ticket")}</div>
          <div class="ticket-meta">${escapeHtml(t.category_label || "")} &middot; sent ${escapeHtml(formatDate(t.created_at))}</div>
        </div>
        <span class="status-pill status-${statusLabel(t.status)}">${statusLabel(t.status)}</span>
      </div>
      <div class="ticket-detail" hidden></div>
    </div>`;
}

ticketListWrap.addEventListener("click", (e) => {
  const item = e.target.closest(".ticket-item");
  if (!item) return;
  if (e.target.closest("button, textarea, input, a")) return;
  const detail = item.querySelector(".ticket-detail");
  const ticket = hub.tickets[item.dataset.ticket];
  if (!ticket) return;
  if (detail.hidden) {
    detail.innerHTML = ticketDetailHtml(ticket);
    detail.hidden = false;
  } else {
    detail.hidden = true;
  }
});

function ticketDetailHtml(t) {
  const answers = Object.entries(t.answers || {}).map(([key, value]) => `
    <div class="review-row">
      <div class="review-key">${escapeHtml(key)}</div>
      <div class="review-val">${escapeHtml(value)}</div>
    </div>`).join("");
  const replies = (t.replies || []).map(r => `
    <div class="reply ${r.staff ? "staff" : ""}">
      <div class="reply-head"><span>${escapeHtml(r.author || "Member")}${r.staff ? " (staff)" : ""}</span><span>${escapeHtml(formatDate(r.at))}</span></div>
      <div class="reply-body">${escapeHtml(r.body)}</div>
    </div>`).join("") || '<div class="empty-note">No replies yet.</div>';
  const open = t.status !== "closed";
  return `
    <div class="review-key" style="margin-bottom: 8px;">What you told us</div>
    <div class="review-list">${answers}</div>
    <div class="review-key" style="margin: 16px 0 8px;">Replies</div>
    <div class="thread">${replies}</div>
    ${open ? `
      <div class="reply-form">
        <textarea class="q-textarea" data-reply="${escapeHtml(t.id)}" maxlength="2000" placeholder="Write a reply to the team"></textarea>
        <div class="wizard-nav">
          <button class="btn danger" data-close="${escapeHtml(t.id)}">${icon("x")} Close ticket</button>
          <button class="btn primary" data-send="${escapeHtml(t.id)}">${icon("send")} Send reply</button>
        </div>
      </div>` : '<div class="empty-note">This ticket is closed.</div>'}`;
}

ticketListWrap.addEventListener("click", async (e) => {
  const sendBtn = e.target.closest("[data-send]");
  const closeBtn = e.target.closest("[data-close]");
  if (!sendBtn && !closeBtn) return;
  const id = (sendBtn || closeBtn).dataset.send || (sendBtn || closeBtn).dataset.close;
  const user = hub.lookupUser;
  if (!user) return;

  if (sendBtn) {
    const box = ticketListWrap.querySelector(`[data-reply="${id}"]`);
    const body = (box && box.value || "").trim();
    if (!body) {
      toast("Write a message first.");
      return;
    }
    sendBtn.disabled = true;
    await ticketAction(`/api/tickets/${id}/reply`, { user_id: user.user_id, body: body }, "Reply sent.");
    return;
  }

  if (closeBtn) {
    if (!confirm("Close this ticket? You can still open a new one later.")) return;
    closeBtn.disabled = true;
    await ticketAction(`/api/tickets/${id}/close`, { user_id: user.user_id }, "Ticket closed.");
  }
});

async function ticketAction(url, payload, okMessage) {
  try {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!res.ok || data.status !== "ok") throw new Error(data.message || "That did not work.");
    hub.tickets[data.ticket.id] = data.ticket;
    toast(okMessage);
    lookupTickets();
  } catch (err) {
    toast(err.message || "That did not work.");
  }
}

/* ---------- boot ---------- */
renderTopics();
showView("support");

try {
  const saved = JSON.parse(localStorage.getItem(HUB_DRAFT_KEY) || "null");
  if (saved && saved.topic && TICKET_TOPICS.some(t => t.id === saved.topic)) {
    hub.topic = saved.topic;
    hub.step = saved.step || 0;
    hub.answers = saved.answers || {};
    supportStart.hidden = true;
    supportWizard.hidden = false;
    renderWizard();
    toast("We kept your last ticket answers.");
  }
} catch (err) { /* no draft */ }
</script>
</body>
</html>