  <section class="view" id="view-support" hidden>
    <div class="panel" id="supportStart">
      <div class="panel-title">Support</div>
      <p class="panel-sub">Pick the topic that fits best. We will ask a few short questions, then send it to the team.</p>
      <div class="topic-grid" id="topicGrid"></div>
    </div>
    <div class="panel" id="supportWizard" hidden></div>
    <div class="panel" id="supportDone" hidden></div>
  </section>

  <section class="view" id="view-tickets" hidden>
    <div class="panel">
      <div class="panel-title">My tickets</div>
      <p class="panel-sub">Type the same username or user ID you used in a ticket to read its status.</p>
      <div class="ticket-toolbar">
        <input class="q-input" id="ticketLookup" placeholder="Username or user ID" autocomplete="off" spellcheck="false">
        <button class="btn primary" id="ticketLookupBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          Look up
        </button>
      </div>
      <div class="q-error" id="ticketLookupError"></div>
      <div id="ticketListWrap"><div class="empty-note">No lookup yet. Add your username or user ID above.</div></div>
    </div>
  </section>

  <section class="view" id="view-info" hidden>
    <div class="panel">
      <div class="panel-title">Info</div>
      <p class="panel-sub">Short answers to the things people ask us most.</p>
      <div class="info-grid">
        <div class="info-card">
          <h3>How support works</h3>
          <ul>
            <li>You send a ticket from this page.</li>
            <li>A staff member reads it and replies.</li>
            <li>You can answer back on the My tickets page.</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>How long it takes</h3>
          <ul>
            <li>Most tickets get an answer within 24 hours.</li>
            <li>Urgent tickets are looked at first.</li>
            <li>You can open up to 5 tickets at once.</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>Before you send</h3>
          <ul>
            <li>Use the name or ID you want us to find.</li>
            <li>Add links if you have proof.</li>
            <li>Keep it short and clear.</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>Commands page</h3>
          <p>Every command the bot has, with what each one does. Search by name, or type your username to see only what your roles can use.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="view" id="view-commands">
  <header>
    <h1>command<span class="accent">s</span> list</h1>
    <p class="subtitle">search, filter, and explore every command</p>
  </header>
  <div class="stats">
    <div class="stat"><div class="stat-num" id="statRoles">0</div><div class="stat-label">Roles</div></div>
    <div class="stat"><div class="stat-num" id="statCmds">0 <small id="statCmdsTotal"></small></div><div class="stat-label">Commands</div></div>
    <div class="stat"><div class="stat-num" id="statFavs">0</div><div class="stat-label">Favorites</div></div>
  </div>
  <div class="controls">
    <div class="search-wrap" id="searchWrap">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input id="searchInput" type="text" placeholder="Search commands, or type @username / UID to look up a member" autocomplete="off" spellcheck="false">
      <span class="kbd-hint">/</span>
      <button class="search-clear" id="searchClear" title="Clear (Esc)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="filters" id="filters"></div>
  </div>
  <div class="results-meta hidden" id="resultsMeta"></div>
  <div class="roles" id="roles"></div>
  <div class="no-results" id="noResults">
    <svg class="no-results-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
    <div class="no-results-title">No commands found</div>
    <div class="no-results-desc">Try a different search or clear the filters.</div>
  </div>
  <footer><div class="box">press <strong>/</strong> to search &middot; <strong>Esc</strong> to clear</div></footer>
  </section>
</div>

<div class="modal-backdrop" id="confirmBackdrop"></div>
<div class="modal" id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
  <div class="modal-card">
    <div class="modal-kicker">Please check</div>
    <div class="modal-title" id="confirmTitle">Is this you?</div>
    <img class="modal-avatar" id="confirmAvatar" alt="">
    <div class="modal-name" id="confirmName"></div>
    <div class="modal-handle" id="confirmHandle"></div>
    <div class="modal-roles" id="confirmRoles"></div>
    <div class="modal-meta" id="confirmMeta"></div>
    <div class="modal-actions">
      <button class="btn ghost" id="confirmNo">No, not me</button>
      <button class="btn primary" id="confirmYes">Yes, that is me</button>
    </div>
    <div class="modal-note">We only use this to find your ticket faster.</div>
  </div>
</div>
<div class="toast" id="toast"></div>
<button class="scroll-top" id="scrollTop" title="Back to top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"></polyline></svg>
</button>
<div class="profile-backdrop" id="profileBackdrop"></div>
<aside class="profile-panel" id="profilePanel">
  <button class="profile-close" id="profileClose" title="Close (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
  <div id="profileContent"></div>
</aside>
<script>
/* ============================================================
   SUPABASE CONFIG (anon key — safe to be public)
   ============================================================ */
const SUPABASE_URL = "https://uzebtuzmvvlufuywcxvw.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV6ZWJ0dXptdnZsdWZ1eXdjeHZ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkyNjc4MDYsImV4cCI6MjEwNDg0MzgwNn0.f9QhXHqQ7VBSTIjz9nBzcgnBk7x_dmmcuKflT5hGqNU";

/* ============================================================
   ROLES — command data
   ============================================================ */
const ROLES = [
  {
    name: "Owners", color: "#d96a6a", soft: "#f6d5d5",
    commands: [
      ["purge <amount>", "Delete recent messages", { how: "Bulk-delete the most recent messages in the current channel.", args: [["<amount>", "Number of messages to delete, 1-1000.", "required"]], ex: [">purge 50", ">purge 100"], use: "Clean up a spam wave or reset a busy channel.", notes: ["Discord enforces a 14-day limit on bulk delete.", "Requires Manage Messages."] }],
      ["purgeuser <user> [amount]", "Delete messages from a user", { how: "Deletes recent messages from one user in the current channel.", args: [["<user>", "Mention, ID, or username.", "required"], ["[amount]", "Scan count. Default 50.", "optional"]], ex: [">purgeuser @spammer", ">purgeuser @spammer 200"], use: "Remove one user's messages without touching others." }],
      ["purgebots [amount]", "Delete bot messages", { how: "Deletes recent messages posted by bots.", args: [["[amount]", "Scan count. Default 50.", "optional"]], ex: [">purgebots", ">purgebots 100"], use: "Clear webhook or bot spam quickly." }],
      ["purgecontains <text>", "Delete messages containing a string", { how: "Deletes messages matching a substring in the last 200 messages.", args: [["<text>", "Substring. Case-insensitive.", "required"]], ex: [">purgecontains discord.gg", ">purgecontains scam"], use: "Wipe invite links or scam phrases in one pass." }],
      ["purgeembeds [amount]", "Delete messages with embeds", { how: "Deletes messages containing embeds.", args: [["[amount]", "Scan count. Default 50.", "optional"]], ex: [">purgeembeds"], use: "Clean link previews and bot spam." }],
      ["purgeattachments [amount]", "Delete messages with attachments", { how: "Deletes messages with file attachments.", args: [["[amount]", "Scan count. Default 50.", "optional"]], ex: [">purgeattachments"], use: "Remove image dumps or leaked files." }],
      ["kick <member> [reason]", "Kick a member", { how: "Removes a member from the server.", args: [["<member>", "Member to kick.", "required"], ["[reason]", "Reason logged.", "optional"]], ex: [">kick @user", ">kick @user Spam"], use: "First-time offenses where you want them gone but not banned." }],
      ["ban <member> [reason]", "Ban a member", { how: "Permanently bans a member.", args: [["<member>", "Target.", "required"], ["[reason]", "Reason.", "optional"]], ex: [">ban @user", ">ban @user Repeated violations"], use: "Serious or repeat offenses." }],
      ["unban <user_id> [reason]", "Unban a user by ID", { how: "Lifts a ban using the user's numeric ID.", args: [["<user_id>", "Discord user ID.", "required"], ["[reason]", "Reason.", "optional"]], ex: [">unban 1243983895481815114"], use: "Reverse a ban after an appeal." }],
      ["softban <member> [reason]", "Ban then unban to purge messages", { how: "Bans and immediately unbans, purging recent messages.", args: [["<member>", "Target.", "required"], ["[reason]", "Reason.", "optional"]], ex: [">softban @user"], use: "Clean a user's recent messages without a permanent ban." }],
      ["tempban <member> <duration> [reason]", "Temporary ban", { how: "Bans for a set time, then auto-unbans.", args: [["<member>", "Target.", "required"], ["<duration>", "e.g. `1h`, `1d`.", "required"], ["[reason]", "Reason.", "optional"]], ex: [">tempban @user 1d", ">tempban @user 7d Harassment"], use: "Cool-off bans." }],
      ["banlist", "List banned users", { how: "Shows up to 100 banned users with reasons.", ex: [">banlist"], use: "Quickly audit bans." }],
      ["timeout <member> <duration> [reason]", "Timeout a member", { how: "Discord-native timeout. They can read but not send.", args: [["<member>", "Target.", "required"], ["<duration>", "Duration. Max 28d.", "required"], ["[reason]", "Reason.", "optional"]], ex: [">timeout @user 10m", ">timeout @user 1d Spamming"], use: "First-step punishment." }],
      ["untimeout <member>", "Remove a timeout", { how: "Ends an active timeout.", args: [["<member>", "Target.", "required"]], ex: [">untimeout @user"], use: "Reverse a timeout." }],
      ["warn <member> [reason]", "Warn a member", { how: "Adds a warning and DMs the member.", args: [["<member>", "Target.", "required"], ["[reason]", "Reason.", "optional"]], ex: [">warn @user Be nice"], use: "Documented soft punishment." }],
      ["warnings <member>", "List warnings for a member", { how: "Lists every warning with moderator and timestamp.", args: [["<member>", "Target.", "required"]], ex: [">warnings @user"], use: "Review history before a decision." }],
      ["delwarn <member> <index>", "Delete a specific warning", { how: "Removes a warning by index.", args: [["<member>", "Target.", "required"], ["<index>", "Warning number.", "required"]], ex: [">delwarn @user 2"], use: "Correct an invalid warning." }],
      ["clearwarnings <member>", "Clear all warnings", { how: "Wipes all warnings for a member.", args: [["<member>", "Target.", "required"]], ex: [">clearwarnings @user"], use: "Full reset after appeal." }],
      ["slowmode <duration> [channel]", "Set slowmode (0 to disable)", { how: "Sets per-user cooldown in a channel.", args: [["<duration>", "e.g. `10s`, `0`.", "required"], ["[channel]", "Default: current.", "optional"]], ex: [">slowmode 10s", ">slowmode 1m #general", ">slowmode 0"], use: "Calm a fast channel." }],
      ["lock [channel]", "Lock a channel", { how: "Denies @everyone send permission.", args: [["[channel]", "Default: current.", "optional"]], ex: [">lock", ">lock #general"], use: "Freeze a channel during an incident." }],
      ["unlock [channel]", "Unlock a channel", { how: "Restores @everyone send permission.", args: [["[channel]", "Default: current.", "optional"]], ex: [">unlock"], use: "Undo a lock." }],
      ["hide [channel]", "Hide a channel", { how: "Removes @everyone view permission.", args: [["[channel]", "Default: current.", "optional"]], ex: [">hide"], use: "Make a channel invisible." }],
      ["unhide [channel]", "Unhide a channel", { how: "Restores @everyone view permission.", args: [["[channel]", "Default: current.", "optional"]], ex: [">unhide"], use: "Undo a hide." }],
      ["lockall", "Lock every text channel", { how: "Locks all text channels. Confirms first.", ex: [">lockall"], use: "Emergency response during a raid." }],
      ["unlockall", "Unlock every text channel", { how: "Unlocks all text channels.", ex: [">unlockall"], use: "End of lockdown." }],
      ["purgechannel [channel]", "Delete and recreate a channel", { how: "Clones the channel (same name, perms, topic) and deletes the original.", args: [["[channel]", "Default: current.", "optional"]], ex: [">purgechannel", ">nuke #general"], use: "Wipe a channel without losing config." }],
      ["nuke [channel]", "Alias for purgechannel", { how: "Same as `>purgechannel`.", ex: [">nuke"], use: "Convenience alias." }],
      ["topic <text>", "Set a channel topic", { how: "Changes the current channel's topic.", args: [["<text>", "New topic.", "required"]], ex: [">topic Welcome to #general!"], use: "Update channel purpose." }],
      ["rename <name> [channel]", "Rename a channel", { how: "Renames a channel.", args: [["<name>", "New name.", "required"], ["[channel]", "Default: current.", "optional"]], ex: [">rename general-chat"], use: "Reorganize names." }],
      ["nick <member> [nickname]", "Change a member's nickname", { how: "Sets or resets a nickname.", args: [["<member>", "Target.", "required"], ["[nickname]", "New nick. Omit to reset.", "optional"]], ex: [">nick @user CoolGuy", ">nick @user"], use: "Enforce nickname policies." }],
      ["resetnick <member>", "Reset a member's nickname", { how: "Resets the nickname back to username.", args: [["<member>", "Target.", "required"]], ex: [">resetnick @user"], use: "Undo forced nick." }],
      ["addrole <member> <role>", "Add a role to a member", { how: "Adds the given role to the member.", args: [["<member>", "Target.", "required"], ["<role>", "Role to add.", "required"]], ex: [">addrole @user Verified"], use: "Grant roles manually." }],
      ["removerole <member> <role>", "Remove a role from a member", { how: "Removes the given role from the member.", args: [["<member>", "Target.", "required"], ["<role>", "Role to remove.", "required"]], ex: [">removerole @user Muted"], use: "Revoke roles manually." }],
      ["roleall <role> [include_bots]", "Give a role to every member", { how: "Assigns the role to every human member.", args: [["<role>", "Role to give.", "required"], ["[include_bots]", "`true` to include bots.", "optional"]], ex: [">roleall Verified"], use: "Bulk role grant." }],
      ["rolecreate <name> [color]", "Create a role", { how: "Creates a new role with an optional color.", args: [["<name>", "Name.", "required"], ["[color]", "Hex color.", "optional"]], ex: [">rolecreate VIP #ffaa00"], use: "Quick role setup." }],
      ["roledelete <role>", "Delete a role", { how: "Deletes a role. Confirms first.", args: [["<role>", "Role.", "required"]], ex: [">roledelete VIP"], use: "Remove obsolete roles." }],
      ["rolecolor <role> <color>", "Change a role's color", { how: "Changes the role's color.", args: [["<role>", "Role.", "required"], ["<color>", "Hex color.", "required"]], ex: [">rolecolor VIP #ffaa00"], use: "Update appearance." }],
      ["dm <member> <message>", "DM a member", { how: "Sends a DM from the bot.", args: [["<member>", "Target.", "required"], ["<message>", "Text.", "required"]], ex: [">dm @user Please review the rules."], use: "Private outreach." }],
      ["say <text>", "Make the bot say something", { how: "Bot echoes your text.", args: [["<text>", "Text.", "required"]], ex: [">say Welcome!"], use: "Announcements without a bot tag." }],
      ["embed <title> <description>", "Send a quick embed", { how: "Sends a basic embed.", args: [["<title>", "Title.", "required"], ["<description>", "Body.", "required"]], ex: [">embed Rules Please read #rules."], use: "Quick formatted announcement." }],
      ["poll <question>", "Yes/no poll", { how: "Posts a yes/no/unsure poll.", args: [["<question>", "Question.", "required"]], ex: [">poll Movie night?"], use: "Fast community voting." }],
      ["massdm <message>", "DM every human member", { how: "Sends the same DM to every non-bot with delays.", args: [["<message>", "Message.", "required"]], ex: [">massdm Maintenance in 1 hour."], use: "Server-wide DM.", notes: ["Heavily rate-limited by Discord."] }],
      ["raidmode", "Toggle raid mode", { how: "Toggles raid mode. Auto-kicks accounts under 1 day old.", ex: [">raidmode"], use: "Emergency defense." }],
      ["posthelp <channel_id>", "Publish the tiered command list", { how: "Posts the full tiered command reference.", args: [["<channel_id>", "Channel ID.", "required"]], ex: [">posthelp 123456789012345678"], use: "Publish reference." }],
      ["slogs", "Toggle message logging", { how: "Turns message logging on/off for this server.", ex: [">slogs"], use: "Enable or disable archiving." }],
      ["checkbg <user>", "Full background check", { how: "Aggregates identity, roles, history, and risk score.", args: [["<user>", "Target.", "required"]], ex: [">checkbg @user"], use: "One-shot review." }],
      ["vhistory <user>", "Browse log threads", { how: "Shows every log thread with an **Open Logs** button.", args: [["<user>", "Target.", "required"]], ex: [">vhistory @user"], use: "Find a user's archived logs." }],
      ["mhistory <user>", "Message history", { how: "Paginated viewer of logged messages.", args: [["<user>", "Target.", "required"]], ex: [">mhistory @user"], use: "Read back what a user said." }],
      ["rhistory <user>", "Deleted message history", { how: "Paginated viewer of deleted messages.", args: [["<user>", "Target.", "required"]], ex: [">rhistory @user"], use: "See what someone tried to hide." }],
      ["ehistory <user>", "Edit history", { how: "Paginated viewer of edits.", args: [["<user>", "Target.", "required"]], ex: [">ehistory @user"], use: "Catch sneaky edits." }],
      ["history <user>", "Moderation history", { how: "Full moderation action summary.", args: [["<user>", "Target.", "required"]], ex: [">history @user"], use: "Audit a user's record." }],
      ["note <user> <text>", "Add a note", { how: "Adds a private staff note.", args: [["<user>", "Target.", "required"], ["<text>", "Note.", "required"]], ex: [">note @user Watch for alts"], use: "Share context." }],
      ["notes <user>", "List notes on a member", { how: "Shows every note on a user.", args: [["<user>", "Target.", "required"]], ex: [">notes @user"], use: "Review accumulated notes." }],
      ["delnote <user> <index>", "Delete a specific note", { how: "Removes one note by index.", args: [["<user>", "Target.", "required"], ["<index>", "Note #.", "required"]], ex: [">delnote @user 2"], use: "Clean up notes." }],
      ["clearnotes <user>", "Clear notes", { how: "Wipes all notes on a user.", args: [["<user>", "Target.", "required"]], ex: [">clearnotes @user"], use: "Full reset." }],
      ["watch <user> <reason>", "Add to watchlist", { how: "Adds a user to the watchlist. Alerts on rejoin.", args: [["<user>", "Target.", "required"], ["<reason>", "Reason.", "required"]], ex: [">watch @user Suspected alt"], use: "Track suspicious accounts." }],
      ["unwatch <user>", "Remove from watchlist", { how: "Removes from the watchlist.", args: [["<user>", "Target.", "required"]], ex: [">unwatch @user"], use: "Clear resolved watches." }],
      ["watchlist", "List watchlist", { how: "Shows every watched user.", ex: [">watchlist"], use: "Review watched users." }],
