# ---- after the restructure ----
# logging/ holds runtime state (JSON stores, message archives, member bot data,
# dev-server logs) and is ignored. The one file that must survive a deploy is
# the GitHub sync allow-list, so it is re-included explicitly.
!logging/github_settings.json
logging/memberbot_data/
logging/message_logs/
logging/deleted_logs/
logging/*.log
logging/*.log.err
logging/run.md

# The GitHub sync allow-list is local tooling state: it is written by the
# /git panel and describes what *this* machine sends. It never needs to travel.
logging/github_settings.json

# NOT ignored: templates/functions/. It is the Cloudflare Pages Functions
# package, so it has to be pushable â€” the Sync tab lists it and Cloudflare
# builds it. (Flask only ever looks up .html files here, so the folder is inert
# on the bot side.)
#
# `pages/` also holds the package, plus schema.sql and the README.
.wrangler/

# Local Pages dev secrets (wrangler). Never committed.
.dev.vars
